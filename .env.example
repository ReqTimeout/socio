# Socio.id environment variables (copy to .env.local)

# Provider SMMturk — JANGAN commit key asli (lihat AGENTS.md §6)
SOCIO_SMMTURK_KEY=
SOCIO_SMMTURK_URL=https://smmturk.org/api/v2
SOCIO_USD_TO_IDR=15800
# Fixed AES-256 key (hex) untuk encrypt provider API key at rest (G5).
# Kalau kosong, derive dari SOCIO_AUTH_SECRET. JANGAN ganti di prod setelah
# ada key ter-encrypt di DB — data lama tidak bisa di-decrypt lagi.
SOCIO_PROVIDER_ENC_KEY=

# Database (MySQL / TiDB)
SOCIO_DB_HOST=127.0.0.1
SOCIO_DB_PORT=3306
SOCIO_DB_NAME=socio_smm
SOCIO_DB_USER=root
SOCIO_DB_PASS=
SOCIO_DB_URL=mysql://root@127.0.0.1:3306/socio_smm

# App
SOCIO_APP_URL=https://app.socio.id
SOCIO_LANDING_URL=https://socio.id
SOCIO_DEV=0

# Reverse-proxy client IP (adapter-node). WAJIB di production belakang
# Traefik/Cloudflare — tanpa ini getClientAddress() return IP docker gateway
# (semua user terlihat 1 IP) yang merusak rate-limit per-IP + session logging.
# Cloudflare set cf-connecting-ip; pakai x-forwarded-for jika proxy lain.
ADDRESS_HEADER=cf-connecting-ip

# Auth
SOCIO_AUTH_SECRET=change-me-32-char-random
# Cloudflare Turnstile — OPT-IN. Leave SOCIO_TURNSTILE_ENABLED=0 to keep auth
# ungated (safe default). Set to 1 ONLY with REAL production keys below; the
# test keys shipped here are DEV-ONLY and will block auth on a prod domain.
SOCIO_TURNSTILE_ENABLED=0
SOCIO_TURNSTILE_SITEKEY=0x4AAAAAAD3RtU-MhZPHl3Fw
SOCIO_TURNSTILE_SECRET=0x4AAAAAAD3RtROl7v2XEf5BAD5o5cQPxx4
# Harden the session cookie with the Secure flag in production (default off = safe).
SOCIO_SECURE_COOKIES=0

# Payment
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=https://app.socio.id/api/webhook/tripay
JASAMUTASI_API_KEY=
JASAMUTASI_CALLBACK_URL=https://app.socio.id/api/webhook/jasamutasi

# Deposit manual BCA + bonus (port PHP lama `add-action.php`)
# Bonus deposit: 0.10 = 10% dari nominal, dikredit saat admin konfirmasi.
SOCIO_DEPOSIT_BONUS=0.10
SOCIO_BCA_NUMBER=1392680815
SOCIO_BCA_NAME=Awangga Ramadhi
# Saldo awal reseller saat aktivasi (sudah termasuk biaya Rp50.000). Spec: 20.000.
SOCIO_RESELLER_BONUS=20000
# Komisi affiliate: 0.02 = 2% dari deposit downline (masuk antrian approval admin).
SOCIO_AFFILIATE_RATE=0.02

# Email — prioritas kirim (putusan 2026-09-29, lihat app/src/lib/server/email.ts):
#   1. RESEND_API_KEY (UTAMA) — IP Resend/SES bersih; IP VPS TNA Hosting sendiri
#      sempat diblok Gmail (550 5.7.25 no PTR + 421 4.7.28 rate-limit).
#   2. SMTP_* (fallback) — mailserver self-hosted di VPS (docker-mailserver).
#      Kalau SMTP diaktifkan lagi, set PTR 130.254.47.93 -> mail.socio.id dulu
#      di panel provider (TNA/Hostinger).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# DKIM private key (mail._domainkey.socio.id) utk signing sisi app; \n escaped.
SOCIO_DKIM_PRIVATE_KEY=
SOCIO_MAIL_FROM=noreply@socio.id
SOCIO_MAIL_FROM_NAME=Socio ID
SOCIO_MAIL_SUPPORT=support@socio.id
SOCIO_MAIL_MAX_PER_RUN=100

# Storage (Cloudflare R2)
CF_ACCOUNT_ID=0298214d1069f75436f490b51ea4763e
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=socio
R2_ENDPOINT=https://0298214d1069f75436f490b51ea4763e.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.socio.id

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@socio.id

# Cron (M4) — JANGAN aktif di local dev (boros API + balapan DB).
# Local: 0 (cron mati, pakai tombol Sync manual di /admin/providers).
# VPS Coolify prod: 1 (cron jalan di container yang sama dengan web).
SOCIO_CRON_ENABLED=0

# Monitoring
AXIOM_TOKEN=

# SEO (M5) — IndexNow key auto-discover via public/indexnow.txt (crawl-able).
# Kalau di-set di env, override file (untuk multi-environment rotation).
# Generate UUID hex baru via: python3 -c "import uuid; print(uuid.uuid4().hex)"
SOCIO_INDEXNOW_KEY=278171ffe6864b2ab698edb195272ea5

# SEO generator (S2e) — LLM provider lokal via tokenrouter (4 keys rotasi).
# Spec §3: "ZEN (opencode zen, 6 free model rotasi) → fallback GROQ".
# Reality: ZEN tidak tersedia publik; pakai tokenrouter.com rotasi 4 keys + glm-5.3-free (free).
# Keys dapat dari: https://api.tokenrouter.com (signup + generate API key)
# Round-robin antar keys: KEY_1 → KEY_2 → KEY_3 → KEY_4 → loop.
# Fallback: SOCIO_LLM_BASE_URL_2 + SOCIO_LLM_KEY_2 (mis. gmi-serving.com dengan GLM-5.2-FP8).
# Token budget: ~3k token/artikel (1 system + 1 user call).
SOCIO_LLM_BASE_URL=https://api.tokenrouter.com/v1
SOCIO_LLM_MODEL=z-ai/glm-5.3-free
SOCIO_LLM_KEY_1=
SOCIO_LLM_KEY_2=
SOCIO_LLM_KEY_3=
SOCIO_LLM_KEY_4=
# Optional fallback (gmi / paid alternative)
SOCIO_LLM_BASE_URL_2=https://api.gmi-serving.com/v1
SOCIO_LLM_MODEL_2=zai-org/GLM-5.2-FP8
SOCIO_LLM_KEY_2_FB=

# ============================================================================
# SEO AUTOMATION (docs/SEO_AUTOMATION_PLAN.md §10) — fase runner/indexing/email
# ============================================================================

# --- Konten terpisah (Revisi 2) ---
# Root folder MDX artikel. Kalau repo konten `socio-seo-content-id` sudah di-clone,
# arahkan ke sana; kalau kosong, script pakai fallback landing/src/content/blog.
SEO_CONTENT_DIR=
# URL repo konten untuk runner clone (private).
SEO_CONTENT_REPO_URL=https://github.com/ReqTimeout/socio-seo-content-id.git
# PAT GitHub untuk runner push repo konten. FINE-GRAINED, scope HANYA repo konten
# (runner fisik tidak boleh punya hak push repo app). JANGAN commit.
GH_TOKEN=

# --- Gate Fase F ---
# Ambang jumlah keyword `approved:true` minimum sebelum generate diizinkan.
SEO_MIN_KEYWORDS=200

# --- Deploy Cloudflare Pages (runner daily/weekly) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=0298214d1069f75436f490b51ea4763e

# --- Indexing / Search Console (Fase D) ---
# Runbook + status terverifikasi: docs/GOOGLE_CLOUD_SETUP.md
# Dev lokal: pakai GSC_SA_FILE=<path> (jangan menyalin private key ke .env).
# Service Account JSON utuh (escaped/newline) utk URL Inspection + Search Analytics API.
GSC_SERVICE_ACCOUNT_JSON=
# base64 JSON SA — WAJIB untuk runner/prod (3.184 char).
#   base64 -i <sa.json> | tr -d '\n'
# Varian gzip+base64url (2.263 char) kalau env manager memotong string >~2.500 char.
GSC_SERVICE_ACCOUNT_JSON_B64=
GSC_SERVICE_ACCOUNT_GZIP_B64URL=
# Project + email SA (bukan rahasia, boleh di-log).
GCP_PROJECT_ID=project-e899f4b3-5062-40a0-b9a
GSC_SERVICE_ACCOUNT_EMAIL=beriklanagency@project-e899f4b3-5062-40a0-b9a.iam.gserviceaccount.com
# PENTING: domain property, BUKAN URL prefix. `https://socio.id/` -> 403 "You do not own this site".
GSC_SITE_URL=sc-domain:socio.id
# Sitemap untuk re-submit berkala.
GSC_SITEMAP_URL=https://socio.id/sitemap-index.xml
# Bing Webmaster API key utk URL Submission — free tier 100 URL/hari + 3.100/bulan
# (terverifikasi 1 Okt 2026). Nama lama BING_SITE_KEY = deprecated.
# WAJIB submit URL canonical dengan trailing slash (contoh /blog/slug/).
BING_API_KEY=
# PageSpeed Insights — tanpa key kena HTTP 429 dari shared IP.
PAGESPEED_API_KEY=

# --- Runner <-> App (Revisi 3: runner tanpa kredensial DB) ---
# Bearer secret utk panggil endpoint internal app (seo-prices, seo-changelog, seo-notify).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEO_RUNNER_SECRET=
SOCIO_APP_URL_SEO=https://app.socio.id

# --- AdSense (Fase B) ---
# Publisher ID socio.id (publik, tampil di source HTML — aman di-commit).
# Kosong = slot iklan TIDAK dirender sama sekali (build bersih).
PUBLIC_ADSENSE_CLIENT=ca-pub-4438184351486735
# Ad unit slot ID dari dashboard AdSense (Angka saja). Kosong = slot itu skip.
PUBLIC_ADSENSE_SLOT_TOP=
# --- GA4 (keputusan user 1 Okt 2026) ---
# Measurement ID. Kosong = GA4 tidak dirender sama sekali (nol overhead, 0 request).
# PENTING: landing-only. app.socio.id SENGAJA tidak dilacak (area login) → tidak ada
# gtag 'linker' karena hanya 1 host. Lihat docs/SEO_AUTOMATION_PLAN_V2.md §14.1.
# Consent Mode v2: default 'denied', banner di landing/src/components/ConsentBanner.astro
# (keputusan juga menahan loader AdSense sampai consent 'all').
PUBLIC_GA4_ID=G-MDJCW053XR
PUBLIC_ADSENSE_SLOT_MID=
PUBLIC_ADSENSE_SLOT_BOTTOM=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
