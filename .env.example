# Socio.id environment variables (copy to .env.local)

# Provider SMMturk — JANGAN commit key asli (lihat AGENTS.md §6)
SOCIO_SMMTURK_KEY=
SOCIO_SMMTURK_URL=https://smmturk.org/api/v2
SOCIO_USD_TO_IDR=15800
# Fixed AES-256 key (hex) untuk encrypt provider API key at rest (G5).
# Kalau kosong, derive dari SOCIO_AUTH_SECRET. JANGAN ganti di prod setelah
# ada key ter-encrypt di DB — data lama tidak bisa di-decrypt lagi.
SOCIO_PROVIDER_ENC_KEY=

# Database (MySQL / TiDB)
SOCIO_DB_HOST=127.0.0.1
SOCIO_DB_PORT=3306
SOCIO_DB_NAME=socio_smm
SOCIO_DB_USER=root
SOCIO_DB_PASS=
SOCIO_DB_URL=mysql://root@127.0.0.1:3306/socio_smm

# App
SOCIO_APP_URL=https://app.socio.id
SOCIO_LANDING_URL=https://socio.id
SOCIO_DEV=0

# Auth
SOCIO_AUTH_SECRET=change-me-32-char-random
# Cloudflare Turnstile — OPT-IN. Leave SOCIO_TURNSTILE_ENABLED=0 to keep auth
# ungated (safe default). Set to 1 ONLY with REAL production keys below; the
# test keys shipped here are DEV-ONLY and will block auth on a prod domain.
SOCIO_TURNSTILE_ENABLED=0
SOCIO_TURNSTILE_SITEKEY=0x4AAAAAAD3RtU-MhZPHl3Fw
SOCIO_TURNSTILE_SECRET=0x4AAAAAAD3RtROl7v2XEf5BAD5o5cQPxx4
# Harden the session cookie with the Secure flag in production (default off = safe).
SOCIO_SECURE_COOKIES=0

# Payment
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=https://app.socio.id/api/webhook/tripay
JASAMUTASI_API_KEY=
JASAMUTASI_CALLBACK_URL=https://app.socio.id/api/webhook/jasamutasi

# Deposit manual BCA + bonus (port PHP lama `add-action.php`)
# Bonus deposit: 0.10 = 10% dari nominal, dikredit saat admin konfirmasi.
SOCIO_DEPOSIT_BONUS=0.10
SOCIO_BCA_NUMBER=1392680815
SOCIO_BCA_NAME=Awangga Ramadhi
# Saldo awal reseller saat aktivasi (sudah termasuk biaya Rp50.000). Spec: 20.000.
SOCIO_RESELLER_BONUS=20000
# Komisi affiliate: 0.02 = 2% dari deposit downline (masuk antrian approval admin).
SOCIO_AFFILIATE_RATE=0.02

# Email (Resend)
RESEND_API_KEY=
SOCIO_MAIL_FROM=noreply@socio.id
SOCIO_MAIL_FROM_NAME=Socio ID
SOCIO_MAIL_SUPPORT=support@socio.id
SOCIO_MAIL_MAX_PER_RUN=100

# Storage (Cloudflare R2)
CF_ACCOUNT_ID=0298214d1069f75436f490b51ea4763e
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=socio
R2_ENDPOINT=https://0298214d1069f75436f490b51ea4763e.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.socio.id

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@socio.id

# Cron (M4) — JANGAN aktif di local dev (boros API + balapan DB).
# Local: 0 (cron mati, pakai tombol Sync manual di /admin/providers).
# VPS Coolify prod: 1 (cron jalan di container yang sama dengan web).
SOCIO_CRON_ENABLED=0

# Monitoring
AXIOM_TOKEN=
