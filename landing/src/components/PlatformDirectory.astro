const fmt = (n: number) => n.toLocaleString('id-ID');
---

<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-md)] border border-[var(--hairline)] bg-[var(--hairline)] sm:grid-cols-3 lg:grid-cols-5" aria-label="Directory layanan per platform">
  {platforms.map((pf, i) => (
    <div class="reveal group relative bg-white p-5 transition-colors hover:bg-[var(--paper-2)]" style={`--d: ${i * 40}ms`}>
      <svg class="h-7 w-7 text-ink transition-transform duration-200 group-hover:scale-105 group-hover:text-[var(--accent-ink)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d={pf.glyph} />
      </svg>
      <dt class="mt-3 font-display text-[15px] font-bold text-ink">{pf.key}</dt>
      <dd class="mt-0.5 text-[11px] text-ink-3">
        <span class="num font-semibold">{fmt(pf.count)}</span> layanan
      </dd>
      <dd class="mt-3 min-h-[72px] space-y-1">
        {(topByPlatform[pf.key] ?? []).slice(0, 3).map((s) => (
          <span class="block truncate text-[12px] text-ink-2">{s}</span>
        ))}
        {(topByPlatform[pf.key] ?? []).length === 0 && (
          <span class="block text-[12px] text-ink-3">Katalog lengkap di panel</span>
        )}
      </dd>
    </div>
  ))}
</dl>
