// D6: PlatformDirectory — dl grid 10 platform: glyph SVG brand + nama + 3 layanan top + count (tabular-nums).
// Plan §4.2 #2. Data dari landing/src/data/prices.json (sync DB — jangan hardcode).
import prices from '../data/prices.json';

interface PlatformCount { services: number; categories: number }
interface TopRow { platform: string; name: string; price: number; priceReseller: number; min: number; refill: boolean }
type PriceData = { platforms: Record<string, PlatformCount | undefined>; top: TopRow[] };

const data = prices as unknown as PriceData;
const p = data.platforms;

// 3 layanan top per platform (dari data.top, urut harga termurah)
const topByPlatform: Record<string, string[]> = {};
for (const t of data.top) {
  (topByPlatform[t.platform] ??= []).push(t.name);
}

