---
import { totalLayanan, totalLayananPlus, totalKategori, hargaMulai } from '../data/siteStats';
// D1: Footer typographic — 3 col utility desktop, grid 2-col mobile (plan §3b #12)
// Mobile: menu sekunder (Blog/API/FAQ/WA) di sini karena dock hanya 3 tab utama.
const year = new Date().getFullYear();
const loginLink = 'https://app.socio.id/login';
const regLink = 'https://app.socio.id/daftar';
const cols = [
  {
    title: 'Produk',
    links: [
      { label: 'Layanan', href: '/layanan' },
      { label: 'Harga', href: '/#harga' },
      { label: 'Reseller', href: '/reseller' },
      { label: 'API', href: 'https://app.socio.id/api-docs' },
    ],
  },
  {
    title: 'Perusahaan',
    links: [
      { label: 'Blog', href: '/blog' },
      { label: 'Cara Kerja', href: '/#cara-kerja' },
      { label: 'FAQ', href: '/#faq' },
    ],
  },
  {
    title: 'Bantuan',
    links: [
      { label: 'Masuk', href: loginLink },
      { label: 'Daftar', href: regLink },
      { label: 'WhatsApp', href: 'https://wa.me/6281221272016' },
    ],
  },
];
---

<footer class="bg-[var(--dark-panel)] py-12 text-sm md:py-16">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid gap-10 md:grid-cols-12">
      <!-- Wordmark + tagline — typographic, bukan card -->
      <div class="md:col-span-5">
        <a href="/" class="font-display text-2xl font-bold tracking-tight" aria-label="Socio.id — beranda">
          <span class="text-[var(--on-dark)]">socio</span><span class="text-[var(--accent)]">.id</span>
        </a>
        <p class="mt-3 max-w-xs text-[var(--on-dark-2)]">
          Panel SMM Indonesia — {totalLayananPlus} layanan semua platform, mulai Rp{hargaMulai}/1k. Proses otomatis 24 jam.
        </p>
      </div>

      <!-- Grid link: mobile 2-col, desktop 3 col utility -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
        {cols.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="text-[11px] font-bold uppercase tracking-widest text-[var(--accent)]">{col.title}</h2>
            <ul class="mt-3 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-[var(--on-dark-2)] transition-colors hover:text-[var(--on-dark)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <!-- mesh: money pages populer (internal linking §3.3) -->
    <nav aria-label="Layanan populer" class="mt-10 border-t border-[var(--hairline-dark)] pt-6">
      <p class="text-[11px] font-bold uppercase tracking-widest text-[var(--accent)]">Layanan populer</p>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[13px]">
        <li><a href="/beli-followers-instagram" class="text-[var(--on-dark-2)] transition-colors hover:text-[var(--on-dark)]">Beli followers Instagram</a></li>
        <li><a href="/beli-views-tiktok" class="text-[var(--on-dark-2)] transition-colors hover:text-[var(--on-dark)]">Jasa viewers TikTok</a></li>
        <li><a href="/beli-followers-tiktok" class="text-[var(--on-dark-2)] transition-colors hover:text-[var(--on-dark)]">Beli followers TikTok</a></li>
        <li><a href="/beli-subscribers-youtube" class="text-[var(--on-dark-2)] transition-colors hover:text-[var(--on-dark)]">Beli subscribers YouTube</a></li>
        <li><a href="/beli-members-telegram" class="text-[var(--on-dark-2)] transition-colors hover:text-[var(--on-dark)]">Beli members Telegram</a></li>
        <li><a href="/layanan" class="font-bold text-[var(--on-dark)]">+ semua layanan →</a></li>
      </ul>
    </nav>

    <div class="mt-8 border-t border-[var(--hairline-dark)] pt-6 text-center text-xs text-[var(--on-dark-2)] md:flex md:items-center md:justify-between md:text-left">
      <p>&copy; {year} Socio.id — Panel SMM Indonesia, harga mulai Rp{hargaMulai}/1k.</p>
      <p class="mt-2 md:mt-0">Dibuat oleh <a href="https://beriklan.co.id" target="_blank" rel="noopener" class="font-bold text-[var(--on-dark)] underline decoration-2 underline-offset-2">beriklan.co.id</a></p>
    </div>
  </div>
</footer>
