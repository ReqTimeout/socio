---
// D5: ProgramLedger — definition list 3 level (Member → Agen → Reseller).
// Plan §4.1 #2: dl ledger, paper bg, bukan 3-tier card generik.
// Harga real dari DB dev 1 Sep (per-1k TikTok Video Views): Member 165 / Agen 138 / Reseller 154.
// Note: harga reseller < member (pricing_rules real), agen = harga paling murah (syarat volume).
const fmt = (n: number) => 'Rp' + n.toLocaleString('id-ID');

const levels = [
  {
    name: 'Member',
    tag: 'Gratis',
    harga: 165,
    desc: 'Daftar langsung jalan. Cocok buat kebutuhan sendiri atau coba-coba panel dulu.',
    syarat: 'Tanpa syarat',
  },
  {
    name: 'Agen',
    tag: 'Syarat volume',
    harga: 138,
    desc: 'Harga paling murah — untuk yang order rutin dalam jumlah besar. Naik level otomatis dari aktivitas akun.',
    syarat: 'Akun aktif & order rutin',
  },
  {
    name: 'Reseller',
    tag: 'Rp50.000 sekali bayar',
    harga: 154,
    desc: 'Sekali bayar Rp50.000 — saldo Rp20.000 langsung masuk plus harga khusus reseller lebih murah dari member, di semua layanan.',
    syarat: 'Bayar sekali, aktif selamanya',
  },
];
---

<section class="bg-[var(--paper)] py-16 md:py-24" aria-labelledby="program-title">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 id="program-title" class="font-display text-[length:var(--text-h2)] font-bold tracking-tight text-ink">
        Tiga level harga. Satu panel.
      </h2>
      <p class="mt-3 text-[length:var(--text-body)] leading-relaxed text-ink-2">
        Contoh harga <strong class="text-ink">TikTok Views /1k</strong> per level —
        semua layanan lain mengikuti pola yang sama.
      </p>
    </div>

    <!-- Definition list ledger: hairline rows, bukan 3-tier pricing card -->
    <dl class="reveal mx-auto mt-10 max-w-3xl divide-y divide-[var(--hairline)] border-y border-[var(--hairline)] md:mt-12" style="--d: 60ms">
      {levels.map((lv, i) => (
        <div class="grid gap-2 py-6 md:grid-cols-[110px_1fr_auto] md:items-center md:gap-6" style={`--d: ${i * 80}ms`}>
          <dt class="flex items-baseline gap-2 md:flex-col md:gap-1">
            <span class="font-display text-[17px] font-bold text-ink">{lv.name}</span>
            <span class={`text-[11px] font-bold uppercase tracking-widest ${i === 2 ? 'text-[var(--accent-ink)]' : 'text-ink-3'}`}>{lv.tag}</span>
          </dt>
          <dd class="min-w-0 text-[14px] leading-relaxed text-ink-2">
            {lv.desc}
            <span class="mt-1 block text-[12px] text-ink-3">{lv.syarat}</span>
          </dd>
          <dd class="md:text-right">
            <span class="num font-mono text-[15px] font-bold text-ink">{fmt(lv.harga)}<span class="text-[11px] font-medium text-ink-3">/1k</span></span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="reveal mx-auto mt-4 max-w-3xl text-[12px] leading-relaxed text-ink-3" style="--d: 120ms">
      Angka di atas harga TikTok Views per 1.000. Harga reseller diatur admin per layanan dan berlaku
      permanen — cek harga terbaru di katalog setelah daftar.
    </p>
  </div>
</section>
