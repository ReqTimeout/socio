---
// D5: TestiReseller — 2 testi ledger row + inisial (pattern TestiLedger D4), paper-2 bg.
// ⚠ TODO(testimoni-asli): kutipan di bawah PLACEHOLDER — GANTI dengan testimoni + foto
// asli dari owner SEBELUM merge ke prod (risiko iklan menyesatkan, PLAN §5.8).
const testi = [
  {
    initials: 'RA',
    name: 'Rizky A.',
    role: 'Reseller SMM · 2 tahun',
    text: 'Modal Rp50rb langsung balik arung. Harga reseller bikin margin aman — order client tinggal tempel link.',
    metric: '1.2 jt order',
  },
  {
    initials: 'HN',
    name: 'Hendra N.',
    role: 'Admin bot Telegram',
    text: 'API-nya stabil, bot saya jalan sendiri gak perlu diemong. Klien nanya status tinggal satu call.',
    metric: '60 rb req/bulan',
  },
];
---

<section class="bg-[var(--paper-2)] py-16 md:py-24" aria-labelledby="testi-r-title">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 id="testi-r-title" class="font-display text-[length:var(--text-h2)] font-bold tracking-tight text-ink">
        Mereka sudah jualan duluan.
      </h2>
    </div>
    <div class="mx-auto mt-10 grid max-w-3xl gap-5 md:mt-14 sm:grid-cols-2">
      {testi.map((t, i) => (
        <div class={`reveal rounded-2xl border-2 border-[var(--ink)] bg-white p-5 shadow-[3px_3px_0_var(--ink)] ${i === 0 ? 'tilt-l-sm' : 'tilt-r-sm'}`} style={`--d: ${i * 80}ms`}>
          <div class="flex items-center gap-3">
            <span class="num grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[var(--pop-mango-soft)] text-[14px] font-extrabold text-ink" aria-hidden="true">
              {t.initials}
            </span>
            <div class="min-w-0">
              <p class="text-[13px] font-bold text-ink-2">{t.name}</p>
              <p class="text-[11px] text-ink-3">{t.role} · <span class="num font-semibold">{t.metric}</span></p>
            </div>
          </div>
          <blockquote class="mt-3 text-[15px] font-medium leading-relaxed text-ink">
            “{t.text}”
          </blockquote>
        </div>
      ))}
    </div>
  </div>
</section>
