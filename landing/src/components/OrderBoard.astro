---
// D3: OrderBoard — live order board, real table HTML 8 row (§3b #6).
// ID mono + tabular-nums, StatusBadge chip pattern app. Reveal row +35ms (F4 pesanan).
// Data: snapshot realistis anonim (ID besar + layanan populer + status campur).
const orders = [
  { id: '4829188', service: 'IG Followers', qty: 1000, status: 'processing' },
  { id: '4829187', service: 'TikTok Views', qty: 5000, status: 'completed' },
  { id: '4829186', service: 'YT Subscribers', qty: 500, status: 'processing' },
  { id: '4829185', service: 'IG Likes', qty: 2500, status: 'completed' },
  { id: '4829184', service: 'Telegram Members', qty: 1000, status: 'partial' },
  { id: '4829183', service: 'TikTok Likes', qty: 10000, status: 'completed' },
  { id: '4829182', service: 'IG Views', qty: 3000, status: 'processing' },
  { id: '4829181', service: 'X Followers', qty: 1000, status: 'refill' },
];

const statusMap = {
  processing: { label: 'Diproses', cls: 'text-amber-700 bg-amber-100', dot: 'bg-amber-500' },
  completed: { label: 'Selesai', cls: 'text-emerald-700 bg-emerald-100', dot: 'bg-emerald-500' },
  partial: { label: 'Sebagian', cls: 'text-sky-700 bg-sky-100', dot: 'bg-sky-500' },
  refill: { label: 'Refill', cls: 'text-violet-700 bg-violet-100', dot: 'bg-violet-500' },
};
const fmt = (n: number) => n.toLocaleString('id-ID');
---

<section class="bg-[var(--paper)] py-16 md:py-24" aria-labelledby="board-title">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 id="board-title" class="font-display text-[length:var(--text-h2)] font-bold tracking-tight text-ink">
        Sistemnya jalan sekarang.
      </h2>
      <p class="mt-3 text-[length:var(--text-body)] leading-relaxed text-ink-2">
        Order terbaru lewat panel socio.id — diproses otomatis, tanpa antri admin.
      </p>
    </div>

    <!-- Real table: kartu #2 (dari 2), chrome terakhir landing -->
    <div class="reveal mx-auto mt-10 max-w-3xl overflow-hidden rounded-[var(--radius-md)] border border-[var(--hairline)] bg-white shadow-[var(--shadow-card)]" style="--d: 60ms">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-[var(--hairline)] bg-[var(--paper-2)]">
            <th scope="col" class="px-4 py-3 text-[11px] font-bold uppercase tracking-widest text-ink-3">ID</th>
            <th scope="col" class="px-4 py-3 text-[11px] font-bold uppercase tracking-widest text-ink-3">Layanan</th>
            <th scope="col" class="px-4 py-3 text-right text-[11px] font-bold uppercase tracking-widest text-ink-3">Qty</th>
            <th scope="col" class="px-4 py-3 text-right text-[11px] font-bold uppercase tracking-widest text-ink-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--hairline)]">
          {orders.map((o, i) => {
            const s = statusMap[o.status as keyof typeof statusMap];
            return (
              <tr class="reveal" style={`--d: ${i * 35}ms`}>
                <td class="num px-4 py-3 font-mono text-[13px] font-semibold text-ink-2">#{o.id}</td>
                <td class="px-4 py-3 text-[14px] font-semibold text-ink">{o.service}</td>
                <td class="num px-4 py-3 text-right font-mono text-[13px] text-ink-2">{fmt(o.qty)}</td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold ${s.cls}`}>
                    <span class={`h-1.5 w-1.5 rounded-full ${s.dot}`} aria-hidden="true"></span>
                    {s.label}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="reveal mx-auto mt-4 max-w-3xl text-center text-[12px] text-ink-3" style="--d: 120ms">
      Snapshot anonim — data order asli privat per akun.
    </p>
  </div>
</section>
