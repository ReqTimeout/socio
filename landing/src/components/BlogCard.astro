---
import { thumbFor } from '../data/blogHeroes';
import { tagsFor } from '../data/blogTags';

// Kartu portal grid — dipakai /blog index + /blog/page/[n].
interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  readMin?: number;
  eager?: boolean;
}

const { id, title, description, category, pubDate, readMin, eager = false } = Astro.props;
const thumb = thumbFor(id, category);
const tags = tagsFor(id, title, category).slice(0, 3);
const fmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(pubDate);
---

<a
  href={`/blog/${id}`}
  class="reveal group flex flex-col overflow-hidden rounded-[20px] border-2 border-[var(--ink)] bg-[var(--paper)] shadow-[4px_4px_0_var(--ink)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[6px_8px_0_var(--ink)]"
  data-cat={category}
  data-tags={tags.join(',')}
  data-title={title.toLowerCase()}
>
  <div class="relative overflow-hidden">
    <img
      src={thumb.src}
      alt={thumb.alt}
      width="400"
      height="300"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
    />
    <span class="absolute left-3 top-3 -rotate-2 rounded-lg border-2 border-[var(--ink)] bg-[var(--pop-mango)] px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-widest text-[var(--ink)] shadow-[2px_2px_0_var(--ink)]">{category}</span>
  </div>
  <div class="flex min-w-0 flex-1 flex-col p-5">
    <h3 class="font-display text-[17px] font-extrabold leading-snug text-ink group-hover:underline group-hover:decoration-[var(--pop-mango)] group-hover:decoration-2 group-hover:underline-offset-4 line-clamp-2">
      {title}
    </h3>
    <p class="mt-2 text-[13.5px] leading-relaxed text-ink-2 line-clamp-2">
      {description}
    </p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((t) => (
        <span class="rounded-full bg-[var(--paper-2)] px-2 py-0.5 text-[11px] font-bold text-ink-2">#{t}</span>
      ))}
    </div>
    <p class="mt-auto flex items-center gap-2 pt-4 text-[12px] font-medium text-ink-3">
      <time datetime={pubDate.toISOString()}>{fmt}</time>
      {readMin && (
        <>
          <span aria-hidden="true">·</span>
          <span class="num">{readMin} mnt</span>
        </>
      )}
    </p>
  </div>
</a>
