---
// D5: ApiTeaser — code block mono ≤14px + link /api-docs. Plan §4.1 #5, paper-2 bg.
const code = `POST https://app.socio.id/api/v2
Key: API_KEY_KAMU
Action: add
{ "service": 12, "link": "https://tiktok.com/@toko", "quantity": 1000 }

→ 200 OK  { "order": 8271 }`;
---

<section class="bg-[var(--paper-2)] py-16 md:py-24" aria-labelledby="api-title">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <div class="reveal">
        <h2 id="api-title" class="font-display text-[length:var(--text-h2)] font-bold tracking-tight text-ink">
          Punya bot? Colok API-nya.
        </h2>
        <p class="mt-3 text-[length:var(--text-body)] leading-relaxed text-ink-2">
          Semua akun reseller dapat API key otomatis — buat bot Telegram, toko online,
          atau panel whitelabel sendiri. Order, cek status, refill, semuanya lewat endpoint.
        </p>
        <ul class="mt-4 space-y-2 text-[14px] text-ink-2">
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 13l4 4L19 7" /></svg>
            Rate-limit 60 request/menit per IP
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 13l4 4L19 7" /></svg>
            Endpoint: services, add, status, refill, profile
          </li>
        </ul>
        <a href="https://app.socio.id/api-docs" class="mt-6 inline-flex min-h-[48px] items-center gap-2 rounded-full border border-[var(--hairline-strong)] bg-white px-6 text-[14px] font-bold text-ink transition-colors hover:border-[var(--accent-ink)] hover:text-[var(--accent-ink)]">
            Baca dokumentasi API
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      </div>

      <!-- Code panel mono -->
      <div class="reveal min-w-0 overflow-x-auto rounded-[var(--radius-md)] border border-[var(--hairline)] bg-ink-900 p-5 shadow-[var(--n)] md:p-6" style="--d: 80ms" role="img" aria-label="Contoh request API order socio.id">
        <pre class="font-mono text-[12px] leading-relaxed text-slate-300 md:text-[13px]"><code>{code}</code></pre>
      </div>
    </div>
  </div>
</section>
