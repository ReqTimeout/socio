---
import { thumbFor } from '../data/blogHeroes';
import { tagCloud } from '../data/blogTags';

// Sidebar portal: cari + topik + terpopuler + CTA reseller. Sticky desktop.
interface Props {
  posts: Array<{ id: string; title: string; category: string; pubDate: Date }>;
  categories: string[];
}

const { posts, categories } = Astro.props;
const cloud = tagCloud(posts);
const popular = [...posts]
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
  .slice(0, 4);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short' }).format(d);
---

<aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
  <!-- Cari -->
  <section class="rounded-2xl border-2 border-[var(--ink)] bg-[var(--paper)] p-5 shadow-[4px_4px_0_var(--ink)]" aria-label="Cari artikel">
    <h2 class="font-display text-[15px] font-extrabold text-ink">Cari artikel</h2>
    <div class="relative mt-3">
      <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input
        id="blog-search"
        type="search"
        placeholder="mis. followers tiktok…"
        autocomplete="off"
        class="min-h-[48px] w-full rounded-full border border-[var(--hairline-strong)] bg-[var(--paper-2)] pl-11 pr-4 text-[14px] text-ink placeholder:text-ink-3 focus:border-[var(--accent-ink)] focus:outline-none"
      />
    </div>
  </section>

  <!-- Topik -->
  <section class="rounded-2xl border-2 border-[var(--ink)] bg-[var(--paper)] p-5 shadow-[4px_4px_0_var(--ink)]" aria-label="Topik populer">
    <h2 class="font-display text-[15px] font-extrabold text-ink">Topik populer</h2>
    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter topik">
      <button
        type="button"
        data-topic="Semua"
        aria-pressed="true"
        class="topic-chip inline-flex min-h-[36px] cursor-pointer items-center rounded-full border border-[var(--hairline-strong)] bg-[var(--ink)] px-3.5 text-[12.5px] font-bold text-white transition-all hover:border-[var(--ink)] active:scale-95"
      >
        Semua
      </button>
      {cloud.map((c) => (
        <button
          type="button"
          data-topic={c.tag}
          aria-pressed="false"
          class="topic-chip inline-flex min-h-[36px] cursor-pointer items-center gap-1.5 rounded-full border border-[var(--hairline-strong)] bg-[var(--paper-2)] px-3.5 text-[12.5px] font-bold text-ink-2 transition-all hover:border-[var(--ink)] hover:text-ink active:scale-95"
        >
          #{c.tag}
          <span class="num rounded-full bg-[var(--paper)] px-1.5 text-[11px] text-ink-3">{c.count}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Kategori -->
  <section class="rounded-2xl border border-[var(--hairline-strong)] bg-[var(--paper-2)] p-5" aria-label="Kategori">
    <h2 class="font-display text-[15px] font-extrabold text-ink">Kategori</h2>
    <ul class="mt-2 divide-y divide-[var(--hairline)]">
      {categories.map((c) => {
        const n = posts.filter((p) => c === 'Semua' || p.category === c).length;
        return (
          <li>
            <button
              type="button"
              data-cat-link={c}
              class="flex w-full items-center justify-between py-2.5 text-left text-[13.5px] font-bold text-ink-2 transition-colors hover:text-ink"
            >
              <span>{c === 'Semua' ? 'Semua artikel' : c}</span>
              <span class="num rounded-full bg-[var(--paper)] px-2 py-0.5 text-[11px] text-ink-3">{c === 'Semua' ? posts.length : n}</span>
            </button>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- Terpopuler -->
  <section class="rounded-2xl border-2 border-[var(--ink)] bg-[var(--paper)] p-5 shadow-[4px_4px_0_var(--ink)]" aria-label="Artikel terpopuler">
    <h2 class="font-display text-[15px] font-extrabold text-ink">Terbaru</h2>
    <ol class="mt-3 space-y-4">
      {popular.map((p, i) => {
        const t = thumbFor(p.id, p.category);
        return (
          <li>
            <a href={`/blog/${p.id}`} class="group flex items-start gap-3">
              <span aria-hidden="true" class="font-display text-2xl font-extrabold leading-none text-[var(--pop-mango)] [text-shadow:1px_1px_0_var(--ink)]">{String(i + 1).padStart(2, '0')}</span>
              <img src={t.src} alt="" width="400" height="300" loading="lazy" decoding="async" class="h-14 w-16 shrink-0 rounded-lg border border-[var(--hairline-strong)] object-cover" />
              <span class="min-w-0">
                <span class="block text-[13.5px] font-bold leading-snug text-ink group-hover:underline group-hover:decoration-[var(--pop-mango)] group-hover:underline-offset-4 line-clamp-2">{p.title}</span>
                <span class="mt-1 block text-[11.5px] font-medium text-ink-3">{fmt(p.pubDate)}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- CTA reseller -->
  <section class="overflow-hidden rounded-2xl border-2 border-[var(--ink)] bg-[var(--ink)] p-5 shadow-[4px_4px_0_var(--pop-mango)]" aria-label="Daftar reseller">
    <p class="inline-block -rotate-1 rounded-lg bg-[var(--pop-mango)] px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-widest text-[var(--ink)]">Buat jualan</p>
    <p class="mt-2.5 font-display text-[17px] font-extrabold leading-snug text-white">Modal Rp50rb, langsung bisa order.</p>
    <a href="/reseller" class="mt-3 block rounded-full bg-[var(--paper)] px-4 py-3 text-center text-[13.5px] font-extrabold text-ink transition-transform hover:scale-[1.02] active:scale-[0.98]">
      Jadi reseller →
    </a>
  </section>
</aside>
