---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import FloatingTabDock from '../components/FloatingTabDock.svelte';
import Footer from '../components/Footer.astro';
import PlatformDirectory from '../components/PlatformDirectory.astro';
import TopLayananTable from '../components/TopLayananTable.svelte';
import KategoriExplainer from '../components/KategoriExplainer.astro';
import prices from '../data/prices.json';
import { hargaMulai } from '../data/siteStats';
import { moneyPagesByPlatform } from '../lib/money-links';

// D6: /layanan — katalog directory (SEO hub). Data dari prices.json, bukan hardcode.
const total = prices.totalServices.toLocaleString('id-ID');
const cats = prices.totalCategories.toLocaleString('id-ID');

// ItemList katalog: /layanan adalah indeks layanan, BUKAN satu product.
// Menempel Product di sini akan salah merepresentasi isi halaman (validator
// juga akan menandainya). Jadi yang tepat ItemList + CollectionPage.
/*
 * ItemList diubah ke money page sungguhan.
 *
 * Versi lama mengisi `mainEntity itemListElement` dengan 50 anchor
 * kategori (anchor ke /layanan#kategori) — itu bukan "item" dari
 * viewpoint schema.org dan tidak ada halaman yang mewakili tiap item.
 * Sekarang daftarnya 44 money page asli: satu item = satu URL yang benar-benar
 * ada, dan link-nya juga jadi jadi jalur crawl internal untuk halaman yang
 * selama ini tidak terindeks.
 */
const groups = moneyPagesByPlatform();
const moneyList = groups.flatMap((g) => g.pages);
const itemList = moneyList.map((p, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: p.keyword,
  url: `https://socio.id/${p.slug}/`,
}));
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Semua Layanan SMM Socio.id',
  description: `Katalog ${total} layanan social media di ${cats} kategori.`,
  url: 'https://socio.id/layanan',
  isPartOf: { '@type': 'WebSite', name: 'Socio.id', url: 'https://socio.id' },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Halaman layanan per layanan',
    numberOfItems: itemList.length,
    itemListElement: itemList,
  },
};
const daftar = 'https://app.socio.id/daftar?mode=reseller';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://socio.id' },
    { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://socio.id/layanan' },
  ],
};
---

<Layout
  title={`Layanan SMM: ${total} Layanan, Harga Live Semua Platform | Socio.id`}
  description={`Katalog ${total} layanan SMM: Instagram, TikTok, YouTube, Telegram, Spotify & ${cats} kategori. Harga live mulai Rp${hargaMulai}/1k — reseller Rp50rb dapat saldo Rp20rb + harga lebih murah.`}
>
  <Navbar client:load />
  <FloatingTabDock client:load />

  <!-- #1 HERO typographic + search (§4.2) -->
  <header class="bg-[var(--paper)] pb-10 pt-32 md:pb-14 md:pt-40">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="reveal mb-6 text-[12px] font-medium text-ink-3">
        <a href="/" class="hover:text-ink underline-offset-2 hover:underline">Beranda</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-ink-2">Layanan</span>
      </nav>
      <div class="reveal max-w-3xl">
        <h1 class="font-display text-[length:var(--text-hero)] font-bold leading-[1.05] tracking-tight text-ink">
          {total} Layanan SMM — Harga Live, Tanpa Kode Promo Palsu.
        </h1>
        <p class="mt-5 max-w-xl text-[length:var(--text-body)] leading-relaxed text-ink-2 md:text-[17px]">
          Harga update otomatis dari provider di
          <span class="num font-semibold text-ink">{cats}</span> kategori — dari Instagram sampai Spotify.
          Toggle harga reseller buat lihat margin cuanmu.
        </p>
      </div>
    </div>
  </header>

  <!-- #2 Platform directory -->
  <section class="bg-[var(--paper)] pb-16 md:pb-24" aria-label="Directory platform">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <PlatformDirectory />
    </div>
  </section>

  <!-- #3 Top layanan table (search + sort island) -->
  <TopLayananTable client:visible />

  <!-- #4b Hub money page — SATU-SATUNYA tempat semua 44 halaman /beli-* mendapat
       link kontekstual dari halaman yang sudah terindeks. Sebelumnya 37 dari 42
       halaman tidak punya inbound link kontekstual sama sekali. -->
  <section class="bg-[var(--paper-2)] py-16 md:py-24" aria-labelledby="hub-judul">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <h2 id="hub-judul" class="font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">
        Halaman per layanan
      </h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-2">
        Tiap layanan punya halaman sendiri: harga real, garansi refill, dan syarat minimumnya.
        Pilih platform dulu, atau langsung <a href="#katalog" class="font-semibold text-ink underline underline-offset-2 hover:decoration-[var(--pop-mango)]">buka katalog lengkap</a>.
      </p>

      <div class="mt-8 space-y-9">
        {groups.map((g) => (
          <div>
            <h3 class="text-[12px] font-bold uppercase tracking-[0.08em] text-ink-3">
              {g.platform} <span class="font-medium normal-case tracking-normal text-ink-3">({g.pages.length})</span>
            </h3>
            <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
              {/*
                Tanpa `truncate` dan tanpa label platform per link:
                - Platform SUDAH tertulis di heading grup, jadi span per link
                  itu redundan.
                - Dengan truncate, 33 dari 44 judul terpotong ellipsis di 360px
                  sehingga user tidak bisa baca labelnya. Wrapping jauh lebih
                  baik di satu kolom; di 2-3 kolom ruangnya tetap cukup karena
                  judul maksimal 2 baris.
                CATATAN: komentar harus DI LUAR arrow function `map` — kalau
                dijadikan saudara langsung <li> di dalam callback, parser Astro
                gagal dengan `Expected ")" but found "$$render"`.
              */}
              {g.pages.map((p) => (
                <li class="min-w-0 border-b border-[var(--hairline)] sm:[&:nth-last-child(-n+2)]:border-b-0">
                  <a
                    href={`/${p.slug}/`}
                    class="group flex min-h-[44px] items-center py-2.5 text-[14px] leading-snug text-ink transition-colors hover:text-ink-2"
                  >
                    <span class="min-w-0 flex-1 font-semibold group-hover:underline group-hover:decoration-[var(--pop-mango)] group-hover:decoration-2 group-hover:underline-offset-4">
                      {p.keyword}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- #5 Kategori explainer -->
  <KategoriExplainer />

  <!-- #6 CTA dark -->
  <section class="relative overflow-hidden bg-[var(--dark-panel)] py-20 text-[var(--on-dark)] isolate md:py-24" aria-labelledby="cta-l-title">
    <div class="mx-auto max-w-3xl px-5 space-y-6 text-center md:px-8">
      <h2 id="cta-l-title" class="font-display text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        Ketemu layanannya? Harganya bisa lebih murah.
      </h2>
      <p class="mx-auto max-w-xl text-[16px] leading-relaxed text-[var(--on-dark-2)]">
        Daftar reseller <strong class="text-white">Rp50.000</strong> — saldo
        <strong class="text-white">Rp20.000</strong> langsung jalan, dan semua harga di atas
        kamu dapat versi lebih murah.
      </p>
      <div class="pt-2">
        <a href={daftar} class="inline-flex min-h-[56px] items-center justify-center gap-2 rounded-full bg-[var(--accent-ink)] px-10 text-[16px] font-bold text-white transition-transform duration-150 hover:bg-[var(--accent-hover)] active:scale-[0.97]">
          Daftar Reseller — Rp50rb
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
