---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import FloatingTabDock from '../components/FloatingTabDock.svelte';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.svelte';
import ProgramLedger from '../components/ProgramLedger.astro';
import ProfitCalculator from '../components/ProfitCalculator.svelte';
import GrosirTable from '../components/GrosirTable.astro';
import ApiTeaser from '../components/ApiTeaser.astro';
import CaraMulaiReseller from '../components/CaraMulaiReseller.astro';
import TestiReseller from '../components/TestiReseller.astro';
import FaqReseller from '../components/FaqReseller.astro';

const daftarReseller = 'https://app.socio.id/daftar?mode=reseller';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://socio.id' },
    { '@type': 'ListItem', position: 2, name: 'Program Reseller', item: 'https://socio.id/reseller' },
  ],
};
---

<Layout
  title="Jadi Reseller SMM — Modal Rp50rb, Saldo Rp20rb Langsung Jalan | Socio.id"
  description="Program reseller socio.id: bayar Rp50.000 sekali, saldo Rp20.000 langsung masuk + harga grosir lebih murah dari member di 8.270 layanan. API untuk bot, garansi refill, proses otomatis 24 jam."
>
  <Navbar client:load />
  <FloatingTabDock client:load />
  <FloatingWhatsApp client:load />

  <!-- #1 HERO: copy-hero no split (§4.1) -->
  <header class="bg-[var(--paper)] pb-16 pt-32 md:pb-24 md:pt-40">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="reveal mb-6 text-[12px] font-medium text-ink-3">
        <a href="/" class="hover:text-ink underline-offset-2 hover:underline">Beranda</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-ink-2">Program Reseller</span>
      </nav>
      <div class="reveal max-w-3xl">
        <p class="text-[12px] font-bold uppercase tracking-widest text-[var(--accent-ink)]">Program Reseller</p>
        <h1 class="mt-3 font-display text-[length:var(--text-hero)] font-bold leading-[1.05] tracking-tight text-ink">
          Jualan followers. Modal Rp50 ribu.
        </h1>
        <p class="mt-5 max-w-xl text-[length:var(--text-body)] leading-relaxed text-ink-2 md:text-[17px]">
          Daftar reseller <strong class="text-ink">Rp50.000 sekali bayar</strong> — saldo
          <strong class="text-ink">Rp20.000 langsung masuk</strong> bisa buat order, plus
          <strong class="text-ink">harga reseller lebih murah dari member</strong> di semua layanan.
          Kamu pasang margin, socio urus stok, proses &amp; refill.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={daftarReseller} class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-[var(--accent-ink)] px-8 text-[15px] font-bold text-white transition-transform duration-150 hover:bg-[var(--accent-hover)] active:scale-[0.97]">
            Daftar Reseller Rp50rb →
          </a>
          <a href="#kalkulator" class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border border-[var(--hairline-strong)] bg-white px-8 text-[15px] font-bold text-ink transition-colors hover:border-[var(--accent-ink)] hover:text-[var(--accent-ink)]">
            Coba kalkulator profit ↓
          </a>
        </div>
        <p class="mt-4 text-[12px] text-ink-3">
          Sekali bayar, aktif selamanya. Tanpa iuran bulanan.
        </p>
      </div>
    </div>
  </header>

  <!-- #2 Program ledger -->
  <ProgramLedger />

  <!-- #3 Kalkulator profit (interaktif) -->
  <div id="kalkulator">
    <ProfitCalculator client:visible />
  </div>

  <!-- #4 Harga grosir vs retail -->
  <GrosirTable />

  <!-- #5 API docs teaser -->
  <ApiTeaser />

  <!-- #6 Cara mulai timeline -->
  <CaraMulaiReseller />

  <!-- #7 Testi reseller -->
  <TestiReseller />

  <!-- #8 FAQ reseller -->
  <FaqReseller />

  <!-- #9 CTA final dark -->
  <section class="relative overflow-hidden bg-ink-900 py-20 text-white isolate md:py-28" aria-labelledby="cta-r-title">
    <div class="mx-auto max-w-3xl px-5 space-y-6 text-center md:px-8">
      <h2 id="cta-r-title" class="font-display text-3xl font-bold leading-tight tracking-tight md:text-5xl">
        Besok client kamu udah order.
      </h2>
      <p class="mx-auto max-w-xl text-[16px] leading-relaxed text-ink-300">
        Daftar malam ini, besok saldo Rp20.000 sudah bisa jalan. Harga reseller langsung
        aktif di 8.270 layanan.
      </p>
      <div class="pt-2">
        <a href={daftarReseller} class="inline-flex min-h-[56px] items-center justify-center gap-2 rounded-full bg-[var(--accent-ink)] px-10 text-[16px] font-bold text-white transition-transform duration-150 hover:bg-[var(--accent-hover)] active:scale-[0.97]">
          Daftar Reseller — Rp50rb
        </a>
      </div>
      <p class="text-[11px] text-ink-400">Dengan mendaftar kamu menyetujui Syarat &amp; Ketentuan Socio.id.</p>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
