---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.svelte';
import NextArticleDock from '../../components/NextArticleDock.svelte';
import Footer from '../../components/Footer.astro';
import ArtThumb from '../../components/ArtThumb.astro';

// D7: /blog/[slug] — artikel single. Spec §3e + §4.3:
// TOC collapsible mobile + sticky desktop, prose 65ch, FAQ + FAQPage schema,
// CTA inline, related 3, Breadcrumb + Article schema. Dock: next-article CTA.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const h2s = headings.filter((h) => h.depth === 2);
const relatedRef = post.data.related ?? [];
const related = (
  await Promise.all(
    relatedRef.map((r) => getEntryById(r.id)),
  )
).filter((e) => e !== null);

// Next article (chronologically older) — wrap around
const allSorted = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const idx = allSorted.findIndex((p) => p.id === post.id);
const nextPost = idx >= 0 ? allSorted[(idx + 1) % allSorted.length] : null;
const next = nextPost && nextPost.id !== post.id ? nextPost : null;

const cat = post.data.category;
const readMin = Math.max(
  3,
  Math.round((post.body ?? '').split(/\s+/).length / 200),
);

async function getEntryById(id: string) {
  const entry = (await getCollection('blog')).find((e) => e.id === id);
  return entry && !entry.data.draft ? entry : null;
}

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
const iso = post.data.pubDate.toISOString();
const url = `https://socio.id/blog/${post.id}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  dateModified: (post.data.updated ?? post.data.pubDate).toISOString(),
  inLanguage: 'id-ID',
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: 'Socio.id', url: 'https://socio.id' },
  publisher: {
    '@type': 'Organization',
    name: 'Socio.id',
    logo: { '@type': 'ImageObject', url: 'https://socio.id/logo.png' },
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.data.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://socio.id/blog' },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: url },
  ],
};
---

<Layout title={`${post.data.title} | Blog Socio.id`} description={post.data.description}>
  <Navbar client:load />
  {next && <NextArticleDock client:load href={`/blog/${next.id}`} title={next.data.title} />}

  <!-- #1 Header artikel -->
  <header class="bg-[var(--paper)] pt-28 md:pt-36">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="reveal text-[12px] font-medium text-ink-3">
        <a href="/blog" class="hover:text-ink underline-offset-2 hover:underline">Blog</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-ink-2">{cat}</span>
      </nav>
      <p class="reveal mt-5 flex flex-wrap items-center gap-2 text-[13px] font-semibold text-ink-3" style="--d: 40ms">
        <span class="rounded-full bg-[var(--accent-tint)] px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-[var(--accent-ink)]">{cat}</span>
        <span class="num">{readMin} mnt baca</span>
        <span aria-hidden="true">·</span>
        <time datetime={iso}>{fmtDate(post.data.pubDate)}</time>
      </p>
      <h1
        class="reveal mt-4 font-display text-3xl font-bold leading-[1.12] tracking-tight text-ink md:text-[40px]"
        style="--d: 80ms"
      >
        {post.data.title}
      </h1>
      <div class="reveal mt-8 md:mt-10" style="--d: 120ms">
        <ArtThumb seed={post.id} size="lg" class="aspect-[16/9] w-full" />
      </div>
    </div>
  </header>

  <!-- #2-3 Body: TOC sticky kiri (desktop) / collapsible (mobile) + prose -->
  <main class="bg-[var(--paper)] pb-16 md:pb-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[260px_minmax(0,1fr)] md:px-8 lg:gap-16">
      <!-- TOC: mobile details / desktop sticky -->
      <aside class="md:order-first">
        <details class="reveal rounded-2xl border border-[var(--hairline)] bg-[var(--paper-2)] p-4 md:hidden">
          <summary class="cursor-pointer list-none text-[14px] font-bold text-ink">
            Daftar isi
            <span class="float-right text-ink-3" aria-hidden="true">⌄</span>
          </summary>
          <nav class="mt-3 space-y-1" aria-label="Daftar isi">
            {h2s.map((h) => (
              <a href={`#${h.slug}`} class="block rounded-lg px-2 py-1.5 text-[13px] font-medium text-ink-2 hover:bg-[var(--paper)] hover:text-ink">
                {h.text}
              </a>
            ))}
          </nav>
        </details>

        <nav class="sticky top-24 hidden max-h-[70vh] space-y-1 overflow-y-auto md:block" aria-label="Daftar isi">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ink-3">Daftar isi</p>
          {h2s.map((h) => (
            <a href={`#${h.slug}`} class="block rounded-lg px-3 py-2 text-[13px] font-medium leading-snug text-ink-2 transition-colors hover:bg-[var(--paper-2)] hover:text-ink">
              {h.text}
            </a>
          ))}
        </nav>
      </aside>

      <article class="min-w-0">
        <div
          class="blog-prose mx-auto max-w-[65ch]
            text-[16px] leading-[1.75] text-ink-2
            [&_a]:font-semibold [&_a]:text-[var(--accent-ink)] [&_a]:underline [&_a]:decoration-[var(--hairline-strong)] [&_a]:underline-offset-4 [&_a:hover]:decoration-[var(--accent-ink)]
            [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-ink [&_h2_scroll-margin-top]:[120px]
            [&_h2]:scroll-mt-28
            [&_blockquote]:my-8 [&_blockquote]:rounded-r-xl [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--accent-ink)] [&_blockquote]:bg-[var(--accent-tint)] [&_blockquote]:p-5 [&_blockquote]:text-[15px] [&_blockquote]:leading-relaxed [&_blockquote]:text-ink
            [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6
            [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6
            [&_strong]:font-bold [&_strong]:text-ink
            [&_table]:my-8 [&_table]:w-full [&_table]:border-collapse [&_table]:text-[14px]
            [&_th]:border [&_th]:border-[var(--hairline-strong)] [&_th]:bg-[var(--paper-2)] [&_th]:px-3 [&_th]:py-2.5 [&_th]:text-left [&_th]:font-bold [&_th]:text-ink
            [&_td]:border [&_td]:border-[var(--hairline)] [&_td]:px-3 [&_td]:py-2.5 [&_td]:text-left
            [&_td]:align-top [&_td]:leading-relaxed
            [&_code]:rounded [&_code]:bg-[var(--paper-2)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[13px]"
        >
          <Content />
        </div>

        <!-- #4 FAQ accordion + schema (reuse pattern accordion home) -->
        <section class="mx-auto mt-14 max-w-[65ch]" aria-labelledby="faq-title">
          <h2 id="faq-title" class="font-display text-2xl font-bold tracking-tight text-ink">Pertanyaan seputar topik ini</h2>
          <div class="mt-6 divide-y divide-[var(--hairline)] border-y border-[var(--hairline)]">
            {post.data.faq.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-[15px] font-bold text-ink marker:hidden">
                  {f.q}
                  <svg class="h-4 w-4 shrink-0 text-ink-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <p class="pb-4 text-[14px] leading-relaxed text-ink-2">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <!-- #5 CTA inline accent tint -->
        <aside class="reveal mx-auto mt-10 max-w-[65ch] rounded-2xl border border-[var(--hairline)] bg-[var(--accent-tint)] p-6 md:p-8">
          <p class="font-display text-lg font-bold text-ink">Mau langsung cek harganya?</p>
          <p class="mt-2 text-[14px] leading-relaxed text-ink-2">
            Katalog 8.270 layanan terbuka untuk semua — daftar reseller Rp50.000 untuk harga
            lebih murah di setiap layanan.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="/layanan" class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-[var(--accent-ink)] px-6 text-[14px] font-bold text-white transition-transform duration-150 hover:scale-[1.03] active:scale-[0.97]">
              Cek harga layanan
            </a>
            <a href="/reseller" class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-[var(--hairline-strong)] bg-[var(--paper)] px-6 text-[14px] font-bold text-ink transition-colors hover:border-[var(--accent-ink)]">
              Daftar reseller
            </a>
          </div>
        </aside>

        <!-- #6 Related ledger rows -->
        {related.length > 0 && (
          <section class="mx-auto mt-14 max-w-[65ch]" aria-labelledby="rel-title">
            <h2 id="rel-title" class="font-display text-xl font-bold tracking-tight text-ink">Baca juga</h2>
            <div class="mt-4 divide-y divide-[var(--hairline)] border-t border-[var(--hairline)]">
              {related.map((r) => (
                <a href={`/blog/${r.id}`} class="group flex items-start gap-4 py-4">
                  <div class="w-16 shrink-0">
                    <ArtThumb seed={r.id} class="aspect-[16/10] w-full" />
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-[15px] font-bold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">{r.data.title}</h3>
                    <p class="mt-1 text-[12px] font-medium text-ink-3">{r.data.category}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Reading progress bar (domain motion) -->
  <script>
    const bar = document.createElement('div');
    bar.style.cssText =
      'position:fixed;top:0;left:0;height:3px;width:0;background:var(--accent-ink);z-index:60;transition:width 80ms linear';
    document.body.appendChild(bar);
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.width = max > 0 ? `${(scrollY / max) * 100}%` : '0';
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Layout>
