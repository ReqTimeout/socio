---
import { totalLayanan } from '../../data/siteStats';
import { heroFor } from '../../data/blogHeroes';
import { tagsFor } from '../../data/blogTags';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.svelte';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';

// /blog — portal berita DNA Socio: hero kompak, featured sticker, grid kartu
// 2 kolom + sidebar sticky (cari, topik, kategori, terbaru, CTA).
const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 3 terlalu sedikit: halaman 1 hanya menampilkan 4 artikel (1 featured + 3),
// jadi pengunjung harus lewat beberapa halaman untuk melihat 10 artikel yang
// published. 12 muat semuanya dalam satu halaman untuk kondisi sekarang, dan
// pagination tetap bekerja saat jumlah artikel bertambah.
const PER_PAGE = 12;
const featured = all.find((a) => a.data.category === 'Reseller') ?? all[0];
const rest = all.filter((a) => a.id !== featured?.id);
const totalPages = Math.max(1, Math.ceil(rest.length / PER_PAGE));
const pageItems = rest.slice(0, PER_PAGE);
const featuredHero = featured ? heroFor(featured.id, featured.data.category) : null;
const featuredTags = featured ? tagsFor(featured.id, featured.data.title, featured.data.category) : [];

const readMin = (body?: string) =>
  Math.max(3, Math.round((body ?? '').split(/\s+/).length / 200));

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);

const categories = ['Semua', 'Followers', 'TikTok', 'Reseller', 'Lainnya'];
const sidebarPosts = all.map((a) => ({ id: a.id, title: a.data.title, category: a.data.category, pubDate: a.data.pubDate }));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Socio.id',
  url: 'https://socio.id/blog',
  description: 'Tips SMM, harga layanan terkini, dan panduan bisnis reseller social media.',
  inLanguage: 'id-ID',
  blogPost: all.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.data.title,
    datePublished: a.data.pubDate.toISOString(),
    url: `https://socio.id/blog/${a.id}`,
  })),
};
// ItemList: hub artikel. page/2 sudah punya ini, page 1 belum → inkonsisten
// dan plan §5.1 menyebut ItemList wajib untuk halaman daftar/pilar.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Artikel Blog Socio.id',
  description: 'Daftar artikel panduan SMM, harga layanan, dan bisnis reseller.',
  numberOfItems: all.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: all.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://socio.id/blog/${a.id}`,
    name: a.data.title,
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://socio.id' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://socio.id/blog' },
  ],
};
---

<Layout
  title="Blog Socio.id — Tips SMM, Harga Real & Panduan Reseller"
  description={`Artikel SMM terbaru: cara aman beli followers, harga TikTok/IG/YouTube terkini dari katalog ${totalLayanan} layanan, dan panduan bisnis reseller modal Rp50 ribu.`}
>
  <Navbar client:load />

  <!-- Hero kompak portal -->
  <header class="relative overflow-hidden bg-[var(--paper)] pb-8 pt-28 md:pb-10 md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute right-[-8%] top-[-30%] h-72 w-72 rounded-full bg-[var(--accent-tint)] blur-2xl"></div>
      <div class="absolute bottom-[-40%] left-[-6%] h-64 w-64 rounded-full bg-[var(--accent-2-tint)] blur-2xl"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="reveal mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--hairline-strong)] bg-[var(--paper)] px-4 py-2 text-[12px] font-semibold text-ink-3">
        <a href="/" class="hover:text-ink hover:underline underline-offset-2">Beranda</a>
        <span aria-hidden="true">→</span>
        <span aria-current="page" class="text-ink-2">Blog</span>
      </nav>
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div class="min-w-0">
          <p class="inline-block -rotate-1 rounded-xl border-2 border-[var(--ink)] bg-[var(--paper)] px-3 py-1 text-[12px] font-extrabold uppercase tracking-widest text-ink shadow-[2px_2px_0_var(--ink)]">
            Blog Socio.id
          </p>
          <h1 class="mt-4 font-display text-[34px] font-extrabold leading-[1.02] tracking-tight text-ink md:text-[52px]">
            Kabar & trik <span class="marker-swipe">jualan sosmed.</span>
          </h1>
        </div>
        <dl class="flex gap-x-7 gap-y-2 pb-1">
          <div class="flex items-baseline gap-2">
            <dd class="num font-display text-2xl font-extrabold text-ink md:text-3xl">{all.length}</dd>
            <dt class="text-[13px] font-semibold text-ink-3">artikel</dt>
          </div>
          <div class="flex items-baseline gap-2">
            <dd class="num font-display text-2xl font-extrabold text-ink md:text-3xl">{totalLayanan}</dd>
            <dt class="text-[13px] font-semibold text-ink-3">layanan</dt>
          </div>
        </dl>
      </div>
      <p class="reveal mt-3 max-w-xl text-[15px] leading-relaxed text-ink-2" style="--d: 60ms">
        Harga real dari katalog, panduan aman, dan hitung-hitung bisnis — ditulis dari data, bukan tebakan.
      </p>
    </div>
  </header>

  <main class="bg-[var(--paper)] pb-16 md:pb-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      {featured && featuredHero && (
        <a
          href={`/blog/${featured.id}`}
          class="reveal group mb-10 block"
          data-cat={featured.data.category}
          data-tags={featuredTags.join(',')}
          data-title={featured.data.title.toLowerCase()}
        >
          <article class="grid gap-0 overflow-hidden rounded-[28px] border-2 border-[var(--ink)] bg-[var(--paper)] shadow-[6px_6px_0_var(--ink)] transition-shadow hover:shadow-[8px_8px_0_var(--ink)] md:grid-cols-2">
            <div class="relative min-h-56 overflow-hidden md:min-h-full">
              <img
                src={featuredHero.src}
                alt={featuredHero.alt}
                width="1200"
                height="675"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
              <span class="absolute left-4 top-4 -rotate-2 rounded-xl border-2 border-[var(--ink)] bg-[var(--pop-mango)] px-3 py-1 text-[11px] font-extrabold uppercase tracking-widest text-[var(--ink)] shadow-[2px_2px_0_var(--ink)]">Unggulan</span>
            </div>
            <div class="min-w-0 p-6 self-center md:p-10">
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] font-semibold text-ink-3">
                <span>{featured.data.category}</span>
                <span aria-hidden="true">·</span>
                <time datetime={featured.data.pubDate.toISOString()}>{fmtDate(featured.data.pubDate)}</time>
              </p>
              <h2 class="mt-3 font-display text-2xl font-extrabold leading-tight tracking-tight text-ink md:text-[32px] md:leading-[1.12] group-hover:underline group-hover:decoration-[var(--pop-mango)] group-hover:decoration-[3px] group-hover:underline-offset-[6px]">
                {featured.data.title}
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-2 line-clamp-3">
                {featured.data.description}
              </p>
              <span class="mt-5 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-[var(--ink)] px-6 text-[14px] font-bold text-white">
                Baca artikel <span aria-hidden="true">→</span>
              </span>
            </div>
          </article>
        </a>
      )}

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
        <div class="min-w-0">
          <div class="mb-5 flex items-center justify-between gap-3">
            <h2 class="font-display text-xl font-extrabold tracking-tight text-ink">Artikel terbaru</h2>
            <p id="blog-count" class="text-[13px] font-semibold text-ink-3" aria-live="polite"></p>
          </div>
          <div id="blog-grid" class="grid gap-6 sm:grid-cols-2">
            {pageItems.map((a) => (
              <BlogCard
                id={a.id}
                title={a.data.title}
                description={a.data.description}
                category={a.data.category}
                pubDate={a.data.pubDate}
                readMin={readMin(a.body)}
              />
            ))}
          </div>
          <p id="blog-empty" hidden class="rounded-2xl border border-dashed border-[var(--hairline-strong)] p-8 text-center text-[14px] font-medium text-ink-3">
            Nggak ketemu artikel yang cocok. Coba kata kunci atau topik lain.
          </p>

          {totalPages > 1 && (
            <nav class="mt-10 flex items-center justify-center gap-1.5" aria-label="Navigasi halaman blog">
              {Array.from({ length: totalPages }, (_, i) => (
                <a
                  href={i === 0 ? '/blog' : `/blog/page/${i + 1}`}
                  aria-current={i === 0 ? 'page' : undefined}
                  aria-label={`Halaman ${i + 1}`}
                  class="grid h-11 min-w-11 place-items-center rounded-full border-2 border-transparent px-3 text-[14px] font-bold text-ink-2 transition-all hover:border-[var(--ink)]
                    aria-[current=page]:border-[var(--ink)] aria-[current=page]:bg-[var(--ink)] aria-[current=page]:text-white aria-[current=page]:shadow-[2px_2px_0_var(--pop-mango)]"
                >
                  {i + 1}
                </a>
              ))}
              <a
                href="/blog/page/2"
                aria-label="Halaman berikutnya"
                class="grid h-11 min-w-11 place-items-center rounded-full border-2 border-transparent px-3 text-[14px] font-bold text-ink-2 transition-all hover:border-[var(--ink)]"
              >
                ›
              </a>
            </nav>
          )}
        </div>

        <BlogSidebar posts={sidebarPosts} categories={categories} />
      </div>

      <!-- Newsletter -->
      <section class="reveal mt-14 overflow-hidden rounded-[28px] border-2 border-[var(--ink)] bg-[var(--ink)] p-6 shadow-[6px_6px_0_var(--pop-mango)] md:p-10" aria-labelledby="nl-title">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="min-w-0">
            <p class="inline-block -rotate-1 rounded-lg bg-[var(--pop-mango)] px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-widest text-[var(--ink)]">Gratis, no spam</p>
            <h2 id="nl-title" class="mt-3 font-display text-2xl font-extrabold text-white md:text-3xl">Artikel baru, langsung ke email.</h2>
            <p class="mt-2 max-w-md text-[14px] leading-relaxed text-white/70">Satu email tiap ada artikel baru soal harga & trik jualan jasa sosmed. Berhenti kapan aja.</p>
          </div>
          <form class="flex w-full max-w-md flex-col gap-2 sm:flex-row" method="POST" action="https://app.socio.id/newsletter">
            <label for="nl-email" class="sr-only">Email</label>
            <input
              id="nl-email"
              type="email"
              name="email"
              required
              placeholder="email@kamu.com"
              class="min-h-[52px] min-w-0 flex-1 rounded-full border-2 border-white/20 bg-white/10 px-5 text-[14px] font-medium text-white placeholder:text-white/40 focus:border-[var(--pop-mango)] focus:outline-none"
            />
            <button
              type="submit"
              class="inline-flex min-h-[52px] shrink-0 items-center justify-center rounded-full bg-[var(--pop-mango)] px-7 text-[14px] font-extrabold text-[var(--ink)] transition-transform duration-150 hover:scale-[1.03] active:scale-[0.97]"
            >
              Langganan
            </button>
          </form>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <script is:inline>
    // Filter portal: topik + kategori + cari — kombinasi AND di halaman aktif.
    (function () {
      const grid = document.getElementById('blog-grid');
      const items = grid ? Array.from(grid.querySelectorAll(':scope > a[data-cat]')) : [];
      const featured = document.querySelector('main > div > a[data-cat]');
      const all = featured ? [featured, ...items] : items;
      const count = document.getElementById('blog-count');
      const empty = document.getElementById('blog-empty');
      const search = document.getElementById('blog-search');
      let topic = 'Semua';
      let cat = 'Semua';
      let q = '';
      function apply() {
        let n = 0;
        all.forEach((el) => {
          const elTopic = (el.getAttribute('data-tags') || '').split(',');
          const okT = topic === 'Semua' || elTopic.includes(topic);
          const okC = cat === 'Semua' || el.getAttribute('data-cat') === cat;
          const okQ = !q || (el.getAttribute('data-title') || '').includes(q);
          const show = okT && okC && okQ;
          el.style.display = show ? '' : 'none';
          if (show) n++;
        });
        if (count) count.textContent = n + ' artikel';
        if (empty) empty.hidden = n !== 0;
      }
      document.querySelectorAll('.topic-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          topic = btn.getAttribute('data-topic') || 'Semua';
          document.querySelectorAll('.topic-chip').forEach((b) => {
            const on = b === btn;
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            b.classList.toggle('bg-[var(--ink)]', on);
            b.classList.toggle('text-white', on);
            b.classList.toggle('bg-[var(--paper-2)]', !on);
          });
          apply();
        });
      });
      document.querySelectorAll('[data-cat-link]').forEach((btn) => {
        btn.addEventListener('click', () => {
          cat = btn.getAttribute('data-cat-link') || 'Semua';
          apply();
        });
      });
      if (search) {
        search.addEventListener('input', () => {
          q = search.value.trim().toLowerCase();
          apply();
        });
      }
      apply();
    })();
  </script>
</Layout>
