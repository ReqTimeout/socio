---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import FloatingTabDock from '../components/FloatingTabDock.svelte';
import Footer from '../components/Footer.astro';
import HeroMockup from '../components/HeroMockup.svelte';
import SmmProviderProof from '../components/SmmProviderProof.svelte';
import ProblemLedger from '../components/ProblemLedger.astro';
import OrderSimulator from '../components/OrderSimulator.svelte';
import OrderBoard from '../components/OrderBoard.astro';
import KapabilitasBento from '../components/KapabilitasBento.astro';
import PricingTable from '../components/PricingTable.astro';
import TestiLedger from '../components/TestiLedger.astro';
import HowItWorks from '../components/HowItWorks.svelte';
import Faq from '../components/Faq.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import FinalCTA from '../components/FinalCTA.svelte';
import FloatingWhatsApp from '../components/FloatingWhatsApp.svelte';

const regBase = 'https://app.socio.id/daftar?mode=reseller';
---

<Layout>
  <Navbar client:load />
  <FloatingTabDock client:idle />

  <StickyCTA client:idle />
  <FloatingWhatsApp client:idle />

  <header class="relative overflow-hidden bg-[var(--paper)] pt-28 pb-16 md:pt-40 md:pb-24">
    <!-- Eyebrow hero — load-sequence (bukan scroll) -->
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:px-8 lg:grid-cols-12">
      <!-- Copy 5/12 mobile-first -->
      <div class="min-w-0 text-center lg:col-span-5 lg:text-left">
        <p class="hero-seq-0 inline-flex items-center gap-2 rounded-full border border-[var(--hairline-strong)] bg-white/60 px-3.5 py-1.5 text-[11px] font-bold tracking-widest text-ink-2 uppercase">
          <span class="live-dot" aria-hidden="true"></span>
          8.270 layanan aktif · semua platform
        </p>

        <h1 class="hero-seq-1 font-display mt-5 text-[length:var(--text-hero)] leading-[1.05] font-bold tracking-tight text-ink">
          Daftar reseller Rp50 ribu,<br />
          <span class="text-[var(--accent-ink)]">saldo Rp20 ribu langsung jalan.</span>
        </h1>

        <p class="hero-seq-2 mx-auto mt-5 max-w-lg text-[length:var(--text-lead)] leading-relaxed text-ink-2 lg:mx-0">
          Biaya daftar sudah termasuk saldo awal — langsung bisa order di 8.270 layanan Instagram,
          TikTok, YouTube, Telegram &amp; SEO. Plus harga reseller: lebih murah dari harga member
          di semua layanan. Proses otomatis 24 jam, garansi refill.
        </p>

        <!-- USP ledger (bukan card) — promo offer di atas -->
        <dl class="hero-seq-3 mx-auto mt-7 max-w-md divide-y divide-[var(--hairline)] border-y border-[var(--hairline)] lg:mx-0">
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Daftar reseller</dt>
            <dd class="num text-[15px] font-bold text-ink">Rp50.000 sekali</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Saldo langsung masuk</dt>
            <dd class="num text-[15px] font-bold text-[var(--accent-ink)]">Rp20.000</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Harga layanan</dt>
            <dd class="text-[15px] font-bold text-ink">Khusus reseller, lebih murah</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Katalog</dt>
            <dd class="num text-[15px] font-bold text-ink">8.270 layanan · 882 kategori</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Proses</dt>
            <dd class="text-[15px] font-bold text-ink">Otomatis 24 jam</dd>
          </div>
        </dl>

        <!-- CTA -->
        <div class="hero-seq-4 mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a
            href={regBase}
            class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[var(--accent-ink)] px-8 text-[15px] font-bold text-white shadow-[0_8px_24px_-8px_var(--accent-ink)] transition-transform duration-150 hover:bg-[var(--accent-hover)] active:scale-[0.97]"
          >
            Daftar Reseller Rp50rb →
          </a>
          <a
            href="/layanan"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-[var(--hairline-strong)] bg-white px-7 text-[15px] font-bold text-ink transition-colors hover:bg-[var(--paper-2)]"
          >
            Lihat 8.270 layanan
          </a>
        </div>
        <p class="hero-seq-5 mt-4 text-[13px] text-ink-3">
          Termasuk saldo Rp20.000 — langsung bisa order · garansi refill 30 hari
        </p>
      </div>

      <!-- Mockup 7/12 -->
      <div class="relative mt-4 flex justify-center lg:col-span-7 lg:justify-end lg:mt-0">
        <!-- client:load (bukan visible): astro-island display:contents + mockup
             entrance transform bikin island rect 0×0 → IO tak pernah trigger.
             Hero = above-fold, harus hidup seketika. -->
        <HeroMockup client:visible />
      </div>
    </div>
  </header>

  <main>
  <SmmProviderProof client:visible />

  <!-- Trust inline-stat prose (bukan 4-col strip — anti-pattern gate) -->
  <section class="border-y border-[var(--hairline)] bg-[var(--paper-2)] py-8 md:py-10" aria-label="Statistik socio.id">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p class="reveal text-center text-[15px] leading-relaxed text-ink-2 md:text-[17px]">
        Sekarang ada <strong class="num text-ink">1.240 order aktif</strong> sedang diproses,
        <strong class="num text-ink">8.270 layanan</strong> di <strong class="num text-ink">882 kategori</strong>,
        rata-rata mulai proses <strong class="num text-ink">42 detik</strong> setelah order —
        dipercaya <strong class="num text-ink">50.000+</strong> reseller &amp; UMKM se-Indonesia.
      </p>
    </div>
  </section>

  <ProblemLedger />

  <!-- D3: domain centerpiece — simulator interaktif (kartu #1) -->
  <OrderSimulator client:visible />

  <!-- D3: live order board (kartu #2 — chrome terakhir landing) -->
  <OrderBoard />

  <!-- D4: bento kapabilitas (kartu ke-2) -->
  <KapabilitasBento />

  <HowItWorks client:visible />

  <!-- D4: testi ledger row (bukan card grid) -->
  <TestiLedger />

  <!-- D4: pricing prose + real table harga (bukan 3-tier card) -->
  <PricingTable />

  <FinalCTA client:visible />

  <section id="faq" class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-5 md:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-ink">
          Pertanyaan yang Sering Ditanyakan
        </h2>
        <p class="mt-2 text-sm md:text-base text-ink-2 max-w-2xl mx-auto">
          Belum menemukan jawabannya? Hubungi tim support kami 24/7 via WhatsApp.
        </p>
      </div>
      <Faq client:visible />
    </div>
  </section>

  </main>

  <Footer />

  <!-- S0: WebSite SearchAction + sitelinks potentialAction untuk homepage (spec SEO §5) -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Socio.id",
      "url": "https://socio.id",
      "inLanguage": "id-ID",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://socio.id/layanan?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Socio.id",
        "logo": "https://socio.id/logo.png"
      }
    }
  </script>
</Layout>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .rotate-y-\[-8deg\] {
    transform: rotateY(-8deg);
  }
  .rotate-x-\[5deg\] {
    transform: rotateX(5deg);
  }
</style>

