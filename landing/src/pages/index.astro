---
import { totalLayanan, totalKategori } from '../data/siteStats';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import FloatingTabDock from '../components/FloatingTabDock.svelte';
import Footer from '../components/Footer.astro';
import HeroMockup from '../components/HeroMockup.svelte';
import LiveTicker from '../components/LiveTicker.astro';
import LiveOrderToast from '../components/LiveOrderToast.svelte';
import Doodle from '../components/Doodle.astro';
import ProblemLedger from '../components/ProblemLedgerMotion.svelte';
import OrderSimulator from '../components/OrderSimulator.svelte';
import OrderBoard from '../components/OrderBoardMotion.svelte';
import KapabilitasBento from '../components/KapabilitasBentoMotion.svelte';
import PricingTable from '../components/PricingTableMotion.svelte';
import TestiLedger from '../components/TestiLedgerMotion.svelte';
import ResellerBand from '../components/ResellerBand.svelte';
import HowItWorks from '../components/HowItWorks.svelte';
import Faq from '../components/Faq.svelte';
import FinalCTA from '../components/FinalCTA.svelte';
import FloatingWhatsApp from '../components/FloatingWhatsApp.svelte';

const regBase = 'https://app.socio.id/daftar';
// V2 §3.3: title ≤70 char (keyword + benefit), desc ≤160 char (keyword + harga + CTA).
const pageTitle = 'SMM Panel Indonesia: Harga Grosir + Garansi Refill | Socio.id';
const pageDesc = `SMM panel Indonesia: ${totalLayanan} layanan IG, TikTok, YouTube & lainnya. Daftar reseller Rp50rb (saldo Rp20rb), proses otomatis 24 jam, garansi refill 30 hari.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <Navbar client:load />
  <FloatingTabDock client:idle />

  <FloatingWhatsApp client:idle />
  <LiveOrderToast client:load />

  <header class="hero relative overflow-hidden bg-[var(--paper)] pt-28 pb-16 md:pt-40 md:pb-24">
    <!-- V2 hero mesh 2 lapis: cyan + violet/mango, drift berlawanan arah,
         pure CSS 0kb JS. Reduced-motion → statis. -->
    <div class="hero-mesh" aria-hidden="true">
      <div class="hero-mesh-inner"></div>
      <div class="hero-mesh-inner-2"></div>
      <div class="hero-grain"></div>
    </div>
    <!-- Eyebrow hero — load-sequence (bukan scroll) -->
    <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-12 px-5 md:px-8 lg:grid-cols-12">
      <!-- Copy 5/12 mobile-first -->
      <div class="min-w-0 text-center lg:col-span-5 lg:text-left">
        <p class="hero-seq-0 inline-flex items-center gap-2 rounded-full border border-[var(--hairline-strong)] bg-white/60 px-3.5 py-1.5 text-[11px] font-bold tracking-widest text-ink-2 uppercase">
          <span class="live-dot" aria-hidden="true"></span>
          {totalLayanan} layanan aktif · semua platform
        </p>

        <h1 class="hero-seq-1 hero-h1 font-display mt-5 font-bold leading-[1.08] tracking-tight text-ink">
          SMM Panel Indonesia yang bikin sosmed kamu
          <span class="marker-swipe"><span class="word-rotate"><span>ramai,</span><span aria-hidden="true">cuan,</span><span aria-hidden="true">viral,</span></span></span>
          dompet aman.
        </h1>

        <p class="hero-seq-2 mx-auto mt-5 max-w-lg text-[length:var(--text-lead)] leading-relaxed text-ink-2 lg:mx-0">
          {totalLayanan} layanan SMM untuk Instagram, TikTok, YouTube, Telegram &amp;
          lainnya. Daftar reseller Rp50.000 sudah termasuk saldo Rp20.000 —
          langsung order, proses otomatis 24 jam, garansi refill 30 hari.
        </p>

        <!-- USP nota-warung (dl existing → sticker style, tilt -1°) -->
        <dl class="sticker tilt-l hero-seq-3 mx-auto mt-7 max-w-md divide-y divide-[var(--hairline)] px-5 py-1 lg:mx-0">
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Daftar reseller</dt>
            <dd class="num text-[15px] font-bold text-ink">Rp50.000 sekali</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Saldo langsung masuk</dt>
            <dd class="num text-[15px] font-bold text-ink">Rp20.000</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Harga layanan</dt>
            <dd class="text-[15px] font-bold text-ink">Grosir reseller</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Katalog</dt>
            <dd class="num text-[15px] font-bold text-ink">{totalLayanan} · {totalKategori} kat</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-[13px] font-semibold text-ink-2">Proses</dt>
            <dd class="text-[15px] font-bold text-ink">Otomatis 24 jam</dd>
          </div>
        </dl>

        <!-- CTA -->
        <div class="hero-seq-4 mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a
            href={regBase}
            class="magnetic cta-glow inline-flex min-h-[52px] items-center justify-center rounded-full bg-[var(--accent-ink)] px-8 text-[15px] font-bold text-white shadow-[0_8px_24px_-8px_var(--accent-ink)] transition-transform duration-150 hover:bg-[var(--accent-hover)] active:scale-[0.97]"
          >
            Daftar Reseller Rp50rb →
          </a>
          <a
            href="/layanan"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-[var(--hairline-strong)] bg-white px-7 text-[15px] font-bold text-ink transition-colors hover:bg-[var(--paper-2)]"
          >
            Intip {totalLayanan} Layanan
          </a>
        </div>
        <!-- Trust line (D-4: "ribuan", bukan 50.000+) + inisial persona (foto asli = TODO owner) -->
        <div class="hero-seq-5 mt-5 flex items-center justify-center gap-3 lg:justify-start">
          <span class="flex -space-x-2" aria-hidden="true">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-[var(--accent-tint)] text-[12px] font-bold text-[var(--accent-ink)]">R</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-[var(--pop-mango-soft)] text-[12px] font-bold text-ink">B</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-[var(--paper-warm-2)] text-[12px] font-bold text-ink-2">A</span>
          </span>
          <p class="text-[13px] text-ink-2">Dipakai <strong class="text-ink">ribuan reseller &amp; UMKM</strong></p>
        </div>
        <p class="hero-seq-5 mt-2 text-[13px] text-ink-3">
          Sekali bayar · tanpa password · garansi refill 30 hari
        </p>
      </div>

      <!-- Mockup 7/12 — frame sticker tilt +2°, doodle tangan, floaters -->
      <div class="tilt-stage relative mt-4 flex justify-center lg:col-span-7 lg:justify-end lg:mt-0">
        <div class="tilt-toward sticker relative p-3 sm:p-4" data-tilt>
          <!-- client:visible: astro-island display:contents + mockup
               entrance transform bikin island rect 0×0 → IO tak pernah trigger.
               Hero = above-fold, harus hidup seketika. -->
          <HeroMockup client:visible />
          <!-- doodle anotasi tangan (D-2, 1 dari max 2 per halaman) -->
          <p class="font-hand absolute -bottom-9 left-2 -rotate-3 text-[22px] leading-none text-ink-2" aria-hidden="true">
            sekali klik, order jalan
            <Doodle name="arrow-curved" class="absolute -top-12 left-24 h-10 w-10 -scale-x-100" />
          </p>
          <!-- sticker kecil float (SVG, bukan emoji) -->
          <Doodle name="star" class="float-idle absolute -top-4 -right-3 h-7 w-7" />
          <Doodle name="sparkle" class="float-slow absolute top-1/2 -left-4 h-5 w-5" />
        </div>
      </div>
    </div>
  </header>

  <main>
  <LiveTicker />

  <ProblemLedger client:visible />

  <!-- D3: domain centerpiece — simulator interaktif (kartu #1) -->
  <OrderSimulator client:visible />

  <!-- D3: live order board — V2-4 stagger 35ms + hover + live-dot pulse -->
  <OrderBoard client:visible />

  <!-- D4: bento kapabilitas — V2-2 svelte-motion stagger (ganti Astro reveal) -->
  <KapabilitasBento client:visible />

  <HowItWorks client:visible />

  <!-- D4: testi ledger — stagger 80ms + avatar hover -->
  <TestiLedger client:visible />

  <!-- D4: pricing prose + real table harga — V2-2 stagger 40ms + hover -->
  <PricingTable client:visible />

  <ResellerBand client:visible />

  <section id="faq" class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-5 md:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <h2 class="reveal font-display text-2xl sm:text-3xl md:text-4xl font-bold text-ink">
          Masih ragu? Wajar. Nih jawaban jujur.
        </h2>
      </div>
      <Faq client:visible />
    </div>
  </section>

  <FinalCTA client:visible />

  </main>

  <Footer />

  <!-- V2 §3.4: FAQPage (AEO/GEO — jawaban dikutip AI Overview/PAA) -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Aman gak sih beli followers?",
          "acceptedAnswer": { "@type": "Answer", "text": "Aman selama caranya benar: socio.id tidak pernah minta password, cukup link publik. Order jalan gradual (bertahap). Risiko drop tetap ada di platform mana pun — layanan bergaransi dapat refill 30 hari otomatis." }
        },
        {
          "@type": "Question",
          "name": "Berapa lama proses order?",
          "acceptedAnswer": { "@type": "Answer", "text": "Rata-rata order mulai jalan kurang dari 1 menit setelah saldo masuk, karena sistem otomatis 24 jam. Kecepatan selesai tergantung antrean provider dan jumlah order." }
        },
        {
          "@type": "Question",
          "name": "Bedanya member & reseller?",
          "acceptedAnswer": { "@type": "Answer", "text": "Member daftar gratis dan langsung bisa order. Reseller bayar Rp50.000 sekali — dapat saldo Rp20.000 plus harga lebih murah di semua layanan, permanen." }
        },
        {
          "@type": "Question",
          "name": "Bayarnya pakai apa?",
          "acceptedAnswer": { "@type": "Answer", "text": "Saat ini via transfer bank (BCA) manual dengan konfirmasi admin. QRIS dan e-wallet otomatis segera hadir." }
        }
      ]
    }
  </script>

  <!-- S0: WebSite SearchAction + sitelinks potentialAction untuk homepage (spec SEO §5) -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Socio.id",
      "url": "https://socio.id",
      "inLanguage": "id-ID",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://socio.id/layanan?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Socio.id",
        "logo": "https://socio.id/logo.png"
      }
    }
  </script>
</Layout>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .rotate-y-\[-8deg\] {
    transform: rotateY(-8deg);
  }
  .rotate-x-\[5deg\] {
    transform: rotateX(5deg);
  }
</style>

