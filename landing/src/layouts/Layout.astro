---
import { totalLayanan, totalKategori, hargaMulai } from '../data/siteStats';
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
// D0: import font aset → Astro kasih hashed URL stabil untuk preload
import soraWoff2 from '../fonts/sora-latin.woff2';
import jakartaWoff2 from '../fonts/plus-jakarta-latin.woff2';

const {
  title = 'Socio.id — Panel SMM Termurah & Tercepat di Indonesia',
  description = `Panel SMM reseller terpercaya: daftar Rp50.000, saldo Rp20.000 langsung jalan + harga reseller lebih murah di ${totalLayanan} layanan Instagram, TikTok, YouTube. Proses otomatis 24 jam, garansi refill.`,
  dockCta = '',
  // B4: adsense=true hanya di halaman artikel blog. Render meta account +
  // loader pagead2 (lazy) HANYA jika PUBLIC_ADSENSE_CLIENT terisi.
  adsense = false,
  // OG image per-halaman (artikel blog pakai foto Unsplash — CTR sosmed).
  ogImageOverride = '',
} = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
// GA4 — landing only (keputusan user 1 Okt 2026: app.socio.id tidak dilacak).
// Karena hanya 1 host, gtag 'linker' tidak dipakai (tidak ada host kedua).
const ga4Id = import.meta.env.PUBLIC_GA4_ID as string | undefined;
const adsenseOn = adsense && !!adsenseClient;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://socio.id').href;
const ogImage = ogImageOverride || new URL('/og-image.png', Astro.site ?? 'https://socio.id').href;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="panel SMM, beli follower, beli like, beli views, jasa follower Instagram, SMM termurah, SMM Indonesia, Socio.id" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Indonesian" />
    <meta name="author" content="Socio.id" />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Socio.id" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* GA4 (G-MDJCW053XR) — Consent Mode v2 WAJIB: default 'denied' di-push
         SEBELUM gtag.js dimuat, kalau tidak consent-nya cuma hiasan dan Google
         tetap mengirim cookie. Loader + event tracking ada di bawah (body),
         بعد banner consented. Kosong = nol overhead. */}
    {ga4Id && (
      <script is:inline define:vars={{ ga4Id }}>
        // 1) Consent default — WAJIB pertama, sebelum gtag.js masuk.
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;

        var stored = '';
        try { stored = localStorage.getItem('socio_consent') || ''; } catch (e) {}
        if (!stored) {
          var m = document.cookie.match(/(?:^|;\s*)socio_consent=([^;]+)/);
          stored = m ? decodeURIComponent(m[1]) : '';
        }
        // Kill switch untuk testing/QA: ?consent=off memaksa 'essential' SEBELUM
        // default dipush. Kalau hanya ditangani di banner, head script ini sudah
        // lebih dulu membaca storage lama → sempat analytic_storage granted.
        var forced = false;
        try {
          forced = new URLSearchParams(location.search).get('consent') === 'off';
          if (forced) {
            stored = 'essential';
            localStorage.setItem('socio_consent', 'essential');
            document.cookie = 'socio_consent=essential;path=/;max-age=15552000;samesite=lax';
          }
        } catch (e) {}
        var granted = !forced && (stored === 'all' || stored === 'analytics');

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          wait_for_update: 500,
        });

        // 2) Muat gtag async (tidak blok render/LCP).
        window.__loadGtag = function () {
          if (window.__ga4Loaded) return;
          window.__ga4Loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
          document.head.appendChild(s);
        };
        window.__ga4Loaded = false;

        if (granted) {
          // Sudah pernah accept → langsung load (tidak perlu banner lagi).
          window.__loadGtag();
        }

        // 3) config: page_location dibersihkan query string (privacy), custom
        //    dimension untuk memisahkan host & tipe halaman.
        window.__ga4Config = function () {
          if (!window.gtag || !window.__ga4Loaded) return;
          gtag('config', ga4Id, {
            send_page_view: true,
            page_location: location.origin + location.pathname,
            page_referrer: document.referrer ? new URL(document.referrer).origin : '',
            allow_google_signals: true,
          });
        };

        // 4) Banner decision → update consent + load (atau blok) gtag.
        document.addEventListener('socio:consent', function (e) {
          var v = (e.detail && e.detail.consent) || '';
          var a = v === 'all' || v === 'analytics';
          window.gtag('consent', 'update', {
            analytics_storage: a ? 'granted' : 'denied',
            ad_storage: v === 'all' ? 'granted' : 'denied',
            ad_user_data: v === 'all' ? 'granted' : 'denied',
            ad_personalization: v === 'all' ? 'granted' : 'denied',
          });
          if (a) {
            window.__loadGtag();
          }
          window.dispatchEvent(new CustomEvent('socio:ads-consent', { detail: { granted: v === 'all' } }));
        });
      </script>
    )}

    {adsenseOn && (
      <>
        <meta name="google-adsense-account" content={adsenseClient} />
        {/* Loader AdSense DIJEDA: hanya setelah consent 'all'. Dengan Consent
             Mode, Google tetap serve iklan cookieless saat ads_storage denied,
             jadi banner tidak mematikan pendapatan — hanya menahan cookie. */}
        <script is:inline define:vars={{ adsenseClient }}>
          window.__loadAdSense = function () {
            if (window.__adsLoaded) return;
            window.__adsLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient;
            document.head.appendChild(s);
          };
          window.__adsLoaded = false;
          var saved = '';
          try { saved = localStorage.getItem('socio_consent') || ''; } catch (e) {}
          if (saved === 'all') window.__loadAdSense();
          document.addEventListener('socio:ads-consent', function (e) {
            if (e.detail && e.detail.granted) window.__loadAdSense();
          });
        </script>
      </>
    )}

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Socio.id",
        "description": "Panel SMM termurah dan tercepat di Indonesia untuk follower, like, view, dan SEO.",
        "url": "https://socio.id",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web-based",
        "offers": {
          "@type": "Offer",
          "price": "50000",
          "priceCurrency": "IDR",
          "priceValidUntil": "2027-12-31"
        },
        "inLanguage": "id-ID"
      }
    </script>

    {/* S0: Organization (global) — JSON.stringify agar selalu JSON valid */}
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Socio.id',
        alternateName: 'Socio ID',
        url: 'https://socio.id',
        logo: {
          '@type': 'ImageObject',
          url: 'https://socio.id/logo.png',
          width: 512,
          height: 512,
        },
        description: `Panel SMM reseller termurah dan tercepat di Indonesia. ${totalLayanan} layanan Instagram, TikTok, YouTube, Telegram, Spotify & SEO.`,
        sameAs: ['https://socio.id'],
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          telephone: '+62-812-2127-2016',
          availableLanguage: ['Indonesian', 'English'],
        },
      })}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Blog Socio.id" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- D3: global reveal observer — trigger .reveal/.marker-swipe/.pop-in di
         markup statik Astro MAUPUN island Svelte yang hydrate belakangan.
         threshold 0.15, sekali saja. MutationObserver menangkap target baru
         dari hydration island (client:visible di bawah fold).
         Fallback scroll-handler: IO callback bisa coalesce saat fast-scroll
         (browser skip posisi intermediate) → elemen pendek kelewat → stuck. -->
    <script>
      // Head-parse: body belum ada → tunda init sampai DOMContentLoaded.
      function initReveal() {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const pending = new Set<Element>();
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) show(e.target as HTMLElement);
            }
          },
          { threshold: 0.15, rootMargin: '-40px' },
        );

        function show(el: HTMLElement) {
          el.style.transitionDelay = el.style.getPropertyValue('--d') || '0ms';
          el.classList.add('is-visible');
          pending.delete(el);
          io.unobserve(el);
        }

        function collect() {
          document.querySelectorAll('.reveal:not(.is-visible), .marker-swipe:not(.is-visible), .pop-in:not(.is-visible)').forEach((el) => {
            if (reduced) {
              el.classList.add('is-visible');
              return;
            }
            // hero = above-fold → langsung, tanpa nunggu scroll
            if (el.closest('header.hero')) {
              el.classList.add('is-visible');
              return;
            }
            if (!pending.has(el)) {
              pending.add(el);
              io.observe(el);
            }
          });
        }

        function checkScroll() {
          if (pending.size === 0) return;
          const limit = innerHeight - 40;
          for (const el of pending) {
            if ((el as HTMLElement).getBoundingClientRect().top < limit) show(el as HTMLElement);
          }
        }

        collect();
        // island hydrate belakangan → tangkap target baru
        new MutationObserver(collect).observe(document.body, { childList: true, subtree: true });
        if (!reduced) {
          // Fallback — scroll event tidak coalesce posisi
          addEventListener(
            'scroll',
            () => requestAnimationFrame(checkScroll),
            { passive: true },
          );
        }
      }
      if (document.body) initReveal();
      else document.addEventListener('DOMContentLoaded', initReveal, { once: true });
    </script>

    <!-- V2 motion lanjutan (A8 magnetic + mockup tilt): desktop pointer:fine saja,
         rAF lerp, skip saat reduced-motion. Tanpa JS = tampilan statis normal. -->
    <script>
      function initMotion() {
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !matchMedia('(pointer: fine)').matches
        )
          return;

        // A8: tombol ketarik max 6px ke arah kursor
        document.querySelectorAll('.magnetic').forEach((el) => {
          const btn = el as HTMLElement;
          let raf = 0;
          let tx = 0;
          let ty = 0;
          let cx = 0;
          let cy = 0;
          const loop = () => {
            cx += (tx - cx) * 0.2;
            cy += (ty - cy) * 0.2;
            btn.style.transform = `translate(${cx.toFixed(1)}px, ${cy.toFixed(1)}px)`;
            if (Math.abs(tx - cx) > 0.1 || Math.abs(ty - cy) > 0.1) raf = requestAnimationFrame(loop);
            else raf = 0;
          };
          const kick = () => {
            if (!raf) raf = requestAnimationFrame(loop);
          };
          btn.addEventListener('mousemove', (e: MouseEvent) => {
            const r = btn.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            tx = Math.max(-6, Math.min(6, dx * 0.06));
            ty = Math.max(-6, Math.min(6, dy * 0.06));
            kick();
          });
          btn.addEventListener('mouseleave', () => {
            tx = 0;
            ty = 0;
            kick();
          });
        });

        // Mockup tilt: miring max ±4deg ngikutin cursor di dalam stage
        document.querySelectorAll('[data-tilt]').forEach((el) => {
          const card = el as HTMLElement;
          const stage = card.closest('.tilt-stage') ?? card;
          stage.addEventListener('mousemove', (e: Event) => {
            const r = (stage as HTMLElement).getBoundingClientRect();
            const px = ((e as MouseEvent).clientX - r.left) / r.width - 0.5;
            const py = ((e as MouseEvent).clientY - r.top) / r.height - 0.5;
            card.style.setProperty('--ry', `${(px * 8).toFixed(2)}deg`);
            card.style.setProperty('--rx', `${(-py * 8).toFixed(2)}deg`);
          });
          stage.addEventListener('mouseleave', () => {
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
          });
        });
      }
      if (document.body) initMotion();
      else document.addEventListener('DOMContentLoaded', initMotion, { once: true });
    </script>

    <!-- D0: font self-host — preload hashed woff2 (LCP: H1 Sora, body PJA).
         Google Fonts CDN dihapus total (zero third-party request). -->
    <link
      rel="preload"
      href={soraWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={jakartaWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>
  <body data-dock-cta={dockCta}>
    <slot />
    <ConsentBanner />

    {ga4Id && (
      // is:inline — script Astro akan ter-hoist keluar kondisi, inline menjaga
      // syarat `ga4Id` dan nol bundle tambahan.
      <script is:inline>
        /* Event taxonomy landing (rencana: docs/SEO_AUTOMATION_PLAN_V2.md §14.1).
           Privasi: TIDAK pernah kirim PII. Query string dibuang dari
           page_location; tidak ada user_id di domain ini. */
        (function () {
          if (!window.gtag) return;

          var sent = {};
          function track(name, params) {
            if (sent[name]) return;
            sent[name] = 1;
            window.gtag('event', name, params || {});
          }

          // Jangan track kalau analytics_storage masih denied (GTM tidak kirim
          // cookieless pings untuk event custom tanpa consent granted).
          function allowed() {
            var c = '';
            try { c = localStorage.getItem('socio_consent') || ''; } catch (e) {}
            if (!c) {
              var m = document.cookie.match(/(?:^|;\s*)socio_consent=([^;]+)/);
              c = m ? decodeURIComponent(m[1]) : '';
            }
            return c === 'all' || c === 'analytics';
          }

          /* 1. CTA → generate_lead. Target: link ke app.socio.id (titik
                konversi utama) + tombol dengan penanda class cta-glow. */
          function onClick(e) {
            if (!allowed()) return;
            var a = e.target.closest('a[href]');
            if (!a) return;
            var href = a.getAttribute('href') || '';
            var text = (a.textContent || '').trim().slice(0, 60);
            var toApp = href.indexOf('app.socio.id') !== -1;

            if (toApp) {
              track('generate_lead', { link_url: href, link_text: text, cta_type: 'to_app' });
              track('outbound_click', { link_url: href, link_text: text, outbound_to: 'app.socio.id' });
              return;
            }
            if (/wa\.me|api\.whatsapp|t\.me|telegram/i.test(href)) {
              track('outbound_click', { link_url: href, link_text: text, outbound_to: 'whatsapp_or_telegram' });
              return;
            }
            // CTA internal yang menyorot (tombol utama di hero / section harga)
            if (/cta-glow/.test(a.className || '')) {
              track('select_promotion', { link_url: href, link_text: text, creative_name: 'hero_cta' });
            }
          }
          addEventListener('click', onClick, { passive: true, capture: true });

          /* 2. Scroll depth 25/50/75/100 — pakai rAF-throttle, bukan IO, karena
                yang kita ukur kedalaman dokumen (bukan elemen). */
          var depths = [25, 50, 75, 100];
          function onScroll() {
            if (!allowed()) return;
            if (window.__scrollPending) return;
            window.__scrollPending = true;
            requestAnimationFrame(function () {
              window.__scrollPending = false;
              var h = document.documentElement;
              var max = (h.scrollHeight - h.clientHeight) || 1;
              var pct = Math.round((h.scrollTop / max) * 100);
              for (var i = 0; i < depths.length; i++) {
                // toleransi 1%: di dasar halaman rasio bisa 99.x sehingga event
                // 100 tidak pernah terkirim (terlihat di uji browser).
                if (pct >= depths[i] - 1 && !sent['sd' + depths[i]]) {
                  sent['sd' + depths[i]] = 1;
                  window.gtag('event', 'scroll_depth', { percent_scrolled: depths[i], page_path: location.pathname });
                }
              }
            });
          }
          addEventListener('scroll', onScroll, { passive: true });
          addEventListener('scroll_end', onScroll, { passive: true });

          /* 3. Config_page_view setelah gtag benar-benar termuat. */
          document.addEventListener('socio:consent', function () {
            var tries = 0;
            var iv = setInterval(function () {
              if (window.__ga4Loaded && window.__ga4Config) {
                clearInterval(iv);
                window.__ga4Config();
                // page_view otomatis sudah terkirim oleh config; tidak perlu kirim ulang.
              } else if (++tries > 40) clearInterval(iv);
            }, 100);
          });
        })();
      </script>
    )}
    {adsenseOn && (
      // is:inline WAJIB — script Astro terproses selalu di-hoist keluar
      // conditional; inline menjaga kondisi + tanpa bundle tambahan.
      <script is:inline>
        // B4: lazy push unit AdSense — isi slot saat user mulai scroll /
        // sentuh / idle 3 dtk. Pola __loadAdSense (beriklan): hemat LCP + CLS.
        function pushAds() {
          const els = document.querySelectorAll('ins.adsbygoogle:not([data-ad-pushed])');
          els.forEach((el) => {
            el.setAttribute('data-ad-pushed', '1');
            try {
              // @ts-ignore — adsbygoogle global dari pagead2
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch {}
          });
        }
        let pushed = false;
        function kick() {
          if (pushed) return;
          pushed = true;
          // Tunggu pagead2 siap (async) sebelum push pertama
          if (window.adsbygoogle) pushAds();
          else {
            let tries = 0;
            const t = setInterval(() => {
              if (window.adsbygoogle || ++tries > 20) {
                clearInterval(t);
                pushAds();
              }
            }, 250);
          }
        }
        addEventListener('scroll', kick, { passive: true, once: true });
        addEventListener('touchstart', kick, { passive: true, once: true });
        addEventListener('click', kick, { once: true });
        setTimeout(kick, 3000);
      </script>
    )}
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
